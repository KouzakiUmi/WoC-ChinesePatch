translate chinese click_map160_5_EV005_a0482775:

    # char_valessa "Is that Alarinthia? It's huge."
    char_valessa "那就是阿拉林西亚吗？好大。"

# game/script.rpy:154276
translate chinese click_map160_5_EV005_e68ae1b6:

    # voice "se/a00259.ogg"
    # char_ulric "No, it's not. That's just immigration."
    voice "se/a00259.ogg"
    char_ulric "不，不是。那只是入境关卡。"

# game/script.rpy:154280
translate chinese click_map160_5_EV005_3e442270:

    # voice "se/a00260.ogg"
    # char_valessa "Immigration?"
    voice "se/a00260.ogg"
    char_valessa "入境关卡？"

# game/script.rpy:154284
translate chinese click_map160_5_EV005_5fcab960:

    # voice "se/a00261.ogg"
    # char_ulric "Yeah. If you're an outsider, you need to register.\nThat is, of course, except during Draycu's annual ball."
    voice "se/a00261.ogg"
    char_ulric "对。如果你是外来者，就得登记。\n当然，德雷库一年一度的舞会期间除外。"

# game/script.rpy:154288
translate chinese click_map160_5_EV005_0ec7ca8b:

    # voice "se/a00262.ogg"
    # char_valessa "So we can just waltz right in to the castle?"
    voice "se/a00262.ogg"
    char_valessa "所以我们可以大摇大摆地直接进城堡？"

# game/script.rpy:154292
translate chinese click_map160_5_EV005_53e4bfdc:

    # voice "se/a00263.ogg"
    # char_ulric "Yeah."
    voice "se/a00263.ogg"
    char_ulric "对。"

# game/script.rpy:154296
translate chinese click_map160_5_EV005_bc58a127:

    # voice "se/a00264.ogg"
    # char_valessa "Isn't that a little dangerous?"
    voice "se/a00264.ogg"
    char_valessa "那不是有点危险吗？"

# game/script.rpy:154300
translate chinese click_map160_5_EV005_11531c7d:

    # voice "se/a00265.ogg"
    # char_ulric "For us and the outsiders, yeah.\nRemember where we are, Valessa.\nDraycu could kill anybody in the blink of an eye."
    voice "se/a00265.ogg"
    char_ulric "对我们和外来者来说，是的。\n记住我们在什么地方，瓦莱莎。\n德雷库眨眼之间就能杀掉任何人。"

# game/script.rpy:154304
translate chinese click_map160_5_EV005_4b8e4167:

    # voice "se/a00266.ogg"
    # char_ulric "Letting in people from the mainland is no threat at all.\nAny threat to Alarinthian soil comes from Alarinthia itself.\nOf course, that brings about its own host of problems."
    voice "se/a00266.ogg"
    char_ulric "放大陆上来的人进来根本算不上威胁。\n对阿拉林西亚土地的任何威胁都来自阿拉林西亚自身。\n当然，这也带来了一系列自己的问题。"

# game/script.rpy:154308
translate chinese click_map160_5_EV005_7efd5d4c:

    # voice "se/a00267.ogg"
    # char_valessa "Wow, you sure know a lot about this stuff."
    voice "se/a00267.ogg"
    char_valessa "哇，你对这些东西懂得真多。"

# game/script.rpy:154312
translate chinese click_map160_5_EV005_a3bd4124:

    # voice "se/a00268.ogg"
    # char_ulric "Unfortunately. "
    voice "se/a00268.ogg"
    char_ulric "遗憾的是，确实如此。"

# game/script.rpy:154350
translate chinese click_map160_7_EV007_4b175277:

    # voice "se/a00250.ogg"
    voice "se/a00250.ogg"

# game/script.rpy:154352
translate chinese click_map160_7_EV007_2c60aac0:

    # char_fortaime "Whoa, I've never seen this kind of tree before.\nIt's looks really cool! What is it, Ulric?"
    char_fortaime "哇，我以前从没见过这种树。\n看起来真酷！这是什么，乌尔里克？"

# game/script.rpy:154355
translate chinese click_map160_7_EV007_fc2b9d93:

    # voice "se/a00251.ogg"
    # char_ulric "It's a pain. They're too thin and weak to be useful.\nAll they can do is provide shade, but even that's weak.\nHiding from the heat in this place is pretty much impossible."
    voice "se/a00251.ogg"
    char_ulric "麻烦得很。它们又细又弱，派不上什么用场。\n唯一的作用就是遮阴，可连这也弱得很。\n想在这地方躲开酷热，基本不可能。"

# game/script.rpy:154359
translate chinese click_map160_7_EV007_81724f69:

    # voice "se/a00252.ogg"
    # char_fortaime "So you can't climb them then, either?"
    voice "se/a00252.ogg"
    char_fortaime "那也就是说你爬不了它们？"

# game/script.rpy:154363
translate chinese click_map160_7_EV007_4a5ac765:

    # voice "se/a00253.ogg"
    # char_ulric "No, I wouldn't advise that.\nThey'd break, and you'd fall to the ground.\nI don't want to play doctor, so just stay away."
    voice "se/a00253.ogg"
    char_ulric "对，我不建议那么做。\n它们会断，你会摔到地上。\n我可不想当医生，所以离远点。"

# game/script.rpy:154367
translate chinese click_map160_7_EV007_70c3b9f6:

    # voice "se/a00254.ogg"
    # char_fortaime "Right, right. Thanks Ulric."
    voice "se/a00254.ogg"
    char_fortaime "好，好。谢了，乌尔里克。"

# game/script.rpy:154374
translate chinese click_map160_7_EV007_b9494cc0:

    # voice "se/a00255.ogg"
    voice "se/a00255.ogg"

# game/script.rpy:154376
