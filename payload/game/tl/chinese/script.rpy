# game/script.rpy:169790
translate chinese Fortaime2_map012_7_0_6b0f88c8:

    # char_fortaime "Awesome, I'm glad you agree!\nThe Rebellion is founded on unity, and it's strong.\nEach nation on its own would stand {i}no{/i} chance of winning."
    char_fortaime "太好了，很高兴你同意！\n反抗军建立在团结之上，因此强大。\n各国各自为战的话，{i}毫无{/i}胜算。"

# game/script.rpy:169795
translate chinese Fortaime2_map012_7_0_54e185c6:

    # voice "se/y00330.ogg"
    # char_fortaime "The Triumvirate won't be the last threat Alestia faces.\nIt's stupid to think that we'd have an eternal peace.\nWe can't band together now, only to split up after."
    voice "se/y00330.ogg"
    char_fortaime "三人执政团不会是阿莱斯蒂亚面临的最后一个威胁。\n以为我们能拥有永恒和平是愚蠢的。\n我们不能现在团结，之后又分裂。"

# game/script.rpy:169817
translate chinese Fortaime2_map012_7_0_4ca2d037:

    # voice "se/y00331.ogg"
    voice "se/y00331.ogg"

# game/script.rpy:169819
translate chinese Fortaime2_map012_7_0_9414ab3f:

    # char_fortaime "Really? Are you sure about that?\nRemember, unity is what's giving us the strength to fight!\nWhy would we unite now, and split apart after we win?"
    char_fortaime "真的？你确定吗？\n记住，是团结给了我们战斗的力量！\n我们为什么要现在团结，赢了之后又分开？"

# game/script.rpy:169824
translate chinese Fortaime2_map012_7_0_b570cbb1:

    # voice "se/y00332.ogg"
    # char_fortaime "Doesn't it seem a little counter-productive?\nI'm sure Alestia will face more threats in the future.\nWe're strong {i}together{/i}, so we should keep it that way!"
    voice "se/y00332.ogg"
    char_fortaime "这看起来是不是有点适得其反？\n我相信阿莱斯蒂亚未来会面临更多威胁。\n我们{i}团结{/i}才强大，所以应该保持下去！"

# game/script.rpy:169846
translate chinese Fortaime2_map012_7_0_9895e8e2:

    # voice "se/y00333.ogg"
    voice "se/y00333.ogg"

# game/script.rpy:169848
