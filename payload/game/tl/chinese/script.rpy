# game/script.rpy:31242
translate chinese click_map054_12_EV012_87c62714:

    # voice "se/a00150.ogg"
    # char_fortaime "Valessa, it was {i}dark{/i}!\nYou'd have done the same thing in my situation."
    voice "se/a00150.ogg"
    char_fortaime "瓦莱莎，当时天{i}黑{/i}了！\n换你在我那个情况下也会一样的。"

# game/script.rpy:31246
translate chinese click_map054_12_EV012_01ef9218:

    # voice "se/a00151.ogg"
    # char_valessa "Not true. I was home a few hours before you.\nJust take Ulric up on his offer Fortaime, he's being nice.\nWho knows what the pirates would do to you if they found you alone."
    voice "se/a00151.ogg"
    char_valessa "才不是。我比你早到家好几个小时。\n福泰姆，就接受乌尔里克的好意吧，他是在对你好。\n谁知道海盗要是发现你落单会干出什么来。"

# game/script.rpy:31250
translate chinese click_map054_12_EV012_d62b343f:

    # voice "se/a00152.ogg"
    # char_fortaime "Okay, and now you're scaring me."
