    # voice "se/z00454.ogg"
    voice "se/z00454.ogg"

# game/script.rpy:168555
translate chinese map019_2a167a6e:

    # char_jit_map008_1_0_111 "Good. That's what I thought.\nTake a few moments to talk amongst yourselves.\nBut when you're ready to go, we need to move as fast as we can."
    char_jit_map008_1_0_111 "很好。我就知道。\n花几分钟你们自己聊聊。\n但准备好出发时，我们得尽快行动。"

# game/script.rpy:168585
translate chinese map019_bad56465:

    # voice "se/z00455.ogg"
    voice "se/z00455.ogg"

# game/script.rpy:168587
translate chinese map019_c493800c:

    # char_fortaime "Alright."
    char_fortaime "好吧。"

# game/script.rpy:168602
translate chinese map019_b36623b6:

    # voice "se/z00456.ogg"
    voice "se/z00456.ogg"

# game/script.rpy:168604
translate chinese map019_e7987090:

    # char_valessa "Yeah, fair enough."
    char_valessa "嗯，有道理。"

# game/script.rpy:168635
translate chinese map019_021e5ff5:

    # "Zamira rests against a nearby tree, and lets out a loud sigh.{w}\nHe was just relaying information. The fallout wasn't his to deal with.{w}\nWe have a few minutes to spare. I should make the most of it."
    "扎米拉靠在旁边一棵树上，重重叹了口气。{w}\n他只是传个话而已。后果不该由他承担。{w}\n我们还有几分钟空闲。我该好好利用。"

# game/script.rpy:169060
translate chinese Valessa1_map012_6_0_b41c75c8:

    # char_valessa "Hey." nointeract
    char_valessa "嘿。" nointeract

# game/script.rpy:169079
translate chinese Valessa1_map012_6_0_78d9345f:

    # voice "se/y00284.ogg"
    # char_valessa "Yeah, of course I do!\nIf I become Elder, then Fortaime can take over as your Scribe.\nIt seems like the logical course of action, doesn't it?"
    voice "se/y00284.ogg"
    char_valessa "当然，我当然愿意！\n如果我当上长老，福泰姆就可以接任你的书记官。\n这似乎是最合乎逻辑的做法，不是吗？"

# game/script.rpy:169085
translate chinese Valessa1_map012_6_0_1f623244:

    # voice "se/y00285.ogg"
    # char_valessa "We need to figure out how to save Valinorth.\nAfter the attack, we can rebuild from the ashes.\nBut I also want to solve our problem with the spirits."
    voice "se/y00285.ogg"
    char_valessa "我们得想办法拯救瓦利诺斯。\n袭击之后，我们可以从灰烬中重建。\n但我也想解决我们与灵之间的问题。"

# game/script.rpy:169091
translate chinese Valessa1_map012_6_0_2e3dcebe:

    # voice "se/y00286.ogg"
    # char_valessa "Once we restore our connection, we'll be fine.\nAfter that, it's just a matter of what we do with our nation.\nI'm not really a fan of what Mylus and his Father did."
    voice "se/y00286.ogg"
    char_valessa "一旦我们恢复了联系，就没事了。\n之后，就只是我们该怎么对待自己的国家了。\n我不太认同迈勒斯和他父亲的做法。"

# game/script.rpy:169113
translate chinese Valessa2_map012_6_0_b1fbbfc2:

    # voice "se/y00287.ogg"
    voice "se/y00287.ogg"

# game/script.rpy:169115
translate chinese Valessa2_map012_6_0_2ffac568:

    # char_valessa "Well, they sacrificed Valinorth's independence.\nThat was the one thing that set us apart — made us unique.\nIf we lose that, we lose Valinorth's very soul."
    char_valessa "嗯，他们牺牲了瓦利诺斯的独立。\n那正是让我们与众不同的东西——让我们独一无二。\n如果我们失去它，就失去了瓦利诺斯的灵魂。"

# game/script.rpy:169120
translate chinese Valessa2_map012_6_0_40917f49:

    # voice "se/y00288.ogg"
    # char_valessa "I want to keep our line of Seers going. We can't lose our heritage.\nI'd ensure that we remained non-partisan, just like always.\nLook at all the trouble these \"alliances\" have given us." nointeract
    voice "se/y00288.ogg"
    char_valessa "我想让我们的先知血脉延续下去。我们不能丢掉传承。\n我会确保我们一如既往地保持不结盟。\n看看这些“联盟”给我们惹了多少麻烦。" nointeract

# game/script.rpy:169140
translate chinese Valessa2_map012_6_0_8b1cd530:

    # voice "se/y00289.ogg"
    # char_valessa "I'm glad you feel the same way.\nWe were fine on our own, for generations.\nIt was Mylus and his Father that got us caught up in politics."
    voice "se/y00289.ogg"
    char_valessa "很高兴你也这么想。\n我们独自屹立了几代人，都好好的。\n是迈勒斯和他父亲把我们卷进了政治。"

# game/script.rpy:169146
translate chinese Valessa2_map012_6_0_6ae4d32c:

    # voice "se/y00290.ogg"
    # char_valessa "Without that, we'd be safe and sound.\nIn fact, we'd be celebrating your induction right now!\nI see independence and strength under {i}my{/i} leadership."
    voice "se/y00290.ogg"
    char_valessa "没有那些，我们本可以安然无恙。\n事实上，我们现在本可以在庆祝你的就任仪式！\n在{i}我{/i}的领导下，我看到的是独立与强大。"

# game/script.rpy:169168
translate chinese Valessa2_map012_6_0_6576eb07:

    # voice "se/y00291.ogg"
    # char_valessa "Strength doesn't come from numbers, though.\nIt comes with the ability to be ourselves. To express what's inside.\nWithout our independence, we're no different from anyone else."
    voice "se/y00291.ogg"
    char_valessa "不过，力量并非来自人数。\n它来自做自己的能力。表达内心的能力。\n没有独立，我们和任何人都没有区别。"

# game/script.rpy:169174
translate chinese Valessa2_map012_6_0_ca6bee5f:

    # voice "se/y00292.ogg"
    # char_valessa "Our line of Seers would lose meaning. Our forests would be cut down.\nAfter a few decades, we'd be no different than Mazeo.\nWe can't lose this beauty. I'll fight to keep it safe."
    voice "se/y00292.ogg"
    char_valessa "我们的先知血脉会失去意义。我们的森林会被砍伐。\n几十年后，我们就会和马泽奥没什么两样。\n我们不能失去这份美丽。我会为守护它而战。"

# game/script.rpy:169196
translate chinese Valessa2_map012_6_0_ca038cb0:

    # voice "se/y00293.ogg"
    # char_valessa "There's really no right or wrong answer.\nIt's just a matter of preference. It could go either way.\nAs long as the leader is capable, Valinorth will be fine."
    voice "se/y00293.ogg"
    char_valessa "其实没有对错之分。\n只是偏好问题。两种都可以。\n只要领袖有能力，瓦利诺斯就会没事。"

# game/script.rpy:169202
translate chinese Valessa2_map012_6_0_7c4d3ef6:

    # voice "se/y00294.ogg"
    # char_valessa "But you should choose either me or Fortaime.\nWe're both trained, and intimately familiar with Valinorth.\nWe studied with Mylus all the time. We can do this, trust me."
    voice "se/y00294.ogg"
    char_valessa "但你该选我或福泰姆。\n我们都受过训练，对瓦利诺斯了如指掌。\n我们一直跟迈勒斯学习。我们能胜任，相信我。"

# game/script.rpy:169224
translate chinese Valessa2_map012_6_0_877daa22:

    # voice "se/y00295.ogg"
    voice "se/y00295.ogg"

# game/script.rpy:169226
translate chinese Valessa2_map012_6_0_53acfc7d:

    # char_valessa "I don't know. But if it's possible, I'll do it.\nI'll look for reading material when we get to Mazeo.\nOr if we ever find ourselves in Balteus, there's the Grand Library."
    char_valessa "我不知道。但如果有可能，我会去做。\n到了马泽奥我会去找阅读材料。\n要是我们哪天真到了巴尔泰乌斯，那里有大图书馆。"

# game/script.rpy:169231
translate chinese Valessa2_map012_6_0_2c770c8a:

    # voice "se/y00296.ogg"
    # char_valessa "Remember, that power still exists within you.\nAfter we defeat The Triumvirate, it won't just vanish.\nThere must be a way to put it back in the Spirit Idol." nointeract
    voice "se/y00296.ogg"
    char_valessa "记住，那股力量仍然存在于你体内。\n打败三人执政团之后，它不会就此消失。\n一定有办法把它放回灵像里。" nointeract

# game/script.rpy:169251
translate chinese Valessa2_map012_6_0_34e2de12:

    # voice "se/y00297.ogg"
    # char_valessa "We definitely will. We can't just let Valinorth die.\nEven if it takes the rest of my life, I'll keep searching.\nI just hope that you'll stay with me along the way."
    voice "se/y00297.ogg"
    char_valessa "我们一定会的。我们不能就这么让瓦利诺斯死去。\n哪怕要花掉我余生，我也会继续寻找。\n我只希望这一路上你能陪着我。"

# game/script.rpy:169273
translate chinese Valessa2_map012_6_0_17d32cbd:

    # voice "se/y00298.ogg"
    # char_valessa "Nothing is impossible, you know.\nThat's just something people say when they don't want to try.\nIf we put all of our effort into it? We can save Valinorth."
    voice "se/y00298.ogg"
    char_valessa "没有什么是不可能的，你知道。\n那只是人们不想尝试时说的话。\n如果我们全力以赴？我们能拯救瓦利诺斯。"

# game/script.rpy:169295
translate chinese Valessa2_map012_6_0_b59ceb0a:

    # voice "se/y00299.ogg"
    voice "se/y00299.ogg"

# game/script.rpy:169297
translate chinese Valessa2_map012_6_0_d0b4ccb8:

    # char_valessa "What!? Why would you say something like that...?\nIt's not like you to give up so easily.\nWe'll come back from this, stronger than ever."
    char_valessa "什么！？你怎么会说这种话……？\n这么轻易放弃可不像你。\n我们会从这件事中恢复过来，比以前更强大。"

# game/script.rpy:169302
translate chinese Valessa2_map012_6_0_52289f17:

    # voice "se/y00300.ogg"
    # char_valessa "In fact, I'm so certain, I'm changing the subject.\nI refuse to talk about such negative things."
    voice "se/y00300.ogg"
    char_valessa "事实上，我这么确定，所以要换个话题。\n我拒绝谈这么消极的事情。"

# game/script.rpy:169328
translate chinese Valessa2_map012_6_0_b23db7bf:

    # voice "se/y00301.ogg"
    # char_valessa "Maybe a couple of hours, if we walk fast.\nIt's a longer trek from there to Mazeo, though.\nI've never been — but I've seen maps and read books."
    voice "se/y00301.ogg"
    char_valessa "如果我们走得快，也许几个小时。\n不过从那里到马泽奥路途更远。\n我从没去过——但我看过地图，读过书。"

# game/script.rpy:169334
translate chinese Valessa2_map012_6_0_0b795ca9:

    # voice "se/y00302.ogg"
    # char_valessa "It's not exactly my kind of place.\nI've never had the urge to drink ale, or wine.\nLet alone the urge to walk such a long distance." nointeract
    voice "se/y00302.ogg"
    char_valessa "那不太算是我喜欢的地方。\n我从没想过要喝麦酒或葡萄酒。\n更别说想走那么远的路了。" nointeract

# game/script.rpy:169354
translate chinese Valessa2_map012_6_0_857513e6:

    # voice "se/y00303.ogg"
    # char_valessa "It's not that I won't. I just don't feel compelled to.\nMaybe I'll feel different when we actually get there.\nI feel like we have more pressing matters at hand."
    voice "se/y00303.ogg"
    char_valessa "不是我不愿意。我只是没有那种冲动。\n也许真到了那里我会有不同的感觉。\n我觉得我们手头有更紧迫的事。"

# game/script.rpy:169376
translate chinese Valessa2_map012_6_0_8b34be37:

    # voice "se/y00305.ogg"
    # char_valessa "It's probably for the best.\nThere's too much we need to take care of.\nMaybe we'll feel different when this is all over."
    voice "se/y00305.ogg"
    char_valessa "大概这样最好。\n我们要操心的事太多了。\n也许等这一切结束后我们的感觉会不同。"

# game/script.rpy:169398
translate chinese Valessa2_map012_6_0_9bd1c8aa:

    # voice "se/y00306.ogg"
    # char_valessa "Hmm? What about it?"
    voice "se/y00306.ogg"
    char_valessa "嗯？怎么了？"

# game/script.rpy:169420
translate chinese Valessa3_map012_6_0_2e18a025:

    # voice "se/y00307.ogg"
    voice "se/y00307.ogg"

# game/script.rpy:169422
translate chinese Valessa3_map012_6_0_1055b494:

    # char_valessa "They usually are.\nIt's not like an argument between us is anything new.\nWith a few minutes to cool off, everything will be fine."
    char_valessa "通常都是这样。\n我们之间的争吵又不是什么新鲜事。\n冷静几分钟，一切就没事了。"

# game/script.rpy:169427
translate chinese Valessa3_map012_6_0_48649ebb:

    # voice "se/y00308.ogg"
    # char_valessa "Besides, we all know what the right choice is.\nI'm the most qualified person in Valinorth to replace Mylus.\nFortaime is trained to replace me. It just seems natural."
    voice "se/y00308.ogg"
    char_valessa "再说，我们都知道正确的选择是什么。\n我是瓦利诺斯最有资格接替迈勒斯的人。\n福泰姆受训是为了接替我。这看起来顺理成章。"

# game/script.rpy:169449
translate chinese Valessa3_map012_6_0_0205c1c7:

    # voice "se/y00309.ogg"
    voice "se/y00309.ogg"

# game/script.rpy:169451
translate chinese Valessa3_map012_6_0_18e829d3:

    # char_valessa "Oh, of course I am!\nI work with Mylus almost every day. I know exactly what he does.\nIn a way, he trained me, just like his Father trained {i}him{/i}."
    char_valessa "哦，我当然能胜任！\n我几乎每天都和迈勒斯一起工作。我清楚他做的一切。\n某种程度上，是他训练了我，就像他父亲训练{i}他{/i}一样。"

# game/script.rpy:169456
translate chinese Valessa3_map012_6_0_b74d5259:

    # voice "se/y00310.ogg"
    # char_valessa "If you chose Fortaime, there'd be a learning curve.\nThat, and I don't think he's fully qualified.\nMake sure not to tell him that. He'll freak out."
    voice "se/y00310.ogg"
    char_valessa "如果你选福泰姆，会有个学习过程。\n而且，我觉得他并不完全够格。\n千万别告诉他这话。他会炸毛的。"

# game/script.rpy:169478
translate chinese Valessa3_map012_6_0_9ef95861:

    # voice "se/y00311.ogg"
    voice "se/y00311.ogg"

# game/script.rpy:169480
translate chinese Valessa3_map012_6_0_b5e5b20f:

    # char_valessa "His contact with Mylus was minimal compared to mine.\nIf he took over, he'd need to be trained from the ground up.\nBut if Mylus is retiring, I don't think he'd be willing to teach."
    char_valessa "他跟迈勒斯的接触比我少得多。\n如果由他接手，得从头开始培训。\n但如果迈勒斯要退休了，我不觉得他愿意教。"

# game/script.rpy:169485
translate chinese Valessa3_map012_6_0_104bc1c2:

    # voice "se/y00312.ogg"
    # char_valessa "And with no teacher, you need to find somebody already trained.\nI have a pretty good idea of what Mylus does. I saw him every day.\nSo I'm trained, and ready to lead. Seems like an easy choice, right?"
    voice "se/y00312.ogg"
    char_valessa "没有老师，你就得找一个已经受过训练的人。\n我很清楚迈勒斯做的事。我每天都见他。\n所以我受过训练，准备好领导了。看起来选择很简单，对吧？"

# game/script.rpy:169507
translate chinese Valessa3_map012_6_0_33174c3e:

    # voice "se/y00313.ogg"
    voice "se/y00313.ogg"

# game/script.rpy:169509
translate chinese Valessa3_map012_6_0_94984754:

    # char_valessa "I'm not sure about that, actually!\nIt would be counterproductive though.\nYou already have two perfect candidates!"
    char_valessa "其实我不太确定！\n不过那样会适得其反。\n你已经有两位完美的人选了！"

# game/script.rpy:169514
translate chinese Valessa3_map012_6_0_0c447baf:

    # voice "se/y00314.ogg"
    # char_valessa "We're high up on Valinorth's ladder. Not many people are.\nI also think that the villagers would support both of us.\nIt seems like a natural succession of power to me."
    voice "se/y00314.ogg"
    char_valessa "我们在瓦利诺斯的层级里位置很高。没多少人能这样。\n我也觉得村民们会支持我们俩。\n在我看来，这就是自然而然的权力传承。"

# game/script.rpy:169540
translate chinese Valessa3_map012_6_0_1e19d605:

    # voice "se/y00315.ogg"
    # char_valessa "I've been thinking about that, actually.\nNot just you, but Damek as well...?\nOnly a Seer of Valinorth can have visions."
    voice "se/y00315.ogg"
    char_valessa "其实我也一直在想这个问题。\n不只是你，还有达梅克……？\n只有瓦利诺斯的先知才能拥有幻象。"

# game/script.rpy:169546
translate chinese Valessa3_map012_6_0_9de679d5:

    # voice "se/y00316.ogg"
    # char_valessa "Is there more to Damek than we know...?\nOr is there more to the blade than we know?\nI'd say it's the energy inside of you, but Damek doesn't have that."
    voice "se/y00316.ogg"
    char_valessa "达梅克身上有我们不知道的东西吗……？\n还是那把剑有我们不知道的东西？\n我会说是你体内的能量，但达梅克没有那个。"

# game/script.rpy:169552
translate chinese Valessa3_map012_6_0_f4cd8016:

    # voice "se/y00317.ogg"
    # char_valessa "Or does he...?\nBasically, none of this makes any sense to me.\nWe're watching the laws of Alestia be remade before us."
    voice "se/y00317.ogg"
    char_valessa "还是说他有……？\n基本上，这对我来说毫无道理。\n我们正看着阿莱斯蒂亚的法则在眼前被重写。"

# game/script.rpy:169558
translate chinese Valessa3_map012_6_0_877fb8fb:

    # voice "se/y00318.ogg"
    # char_valessa "So if you're asking me for an answer, I really don't know.\nIt's something we'll have to learn as we venture forward.\nBut I have a feeling that this blade changes {i}everything{/i}."
    voice "se/y00318.ogg"
    char_valessa "所以如果你是在问我答案，我真的不知道。\n这是我们前进途中要去弄明白的事。\n但我有种感觉，这把剑会改变{i}一切{/i}。"

# game/script.rpy:169626
translate chinese Fortaime1_map012_7_0_bda70beb:

    # char_fortaime "Hey." nointeract
    char_fortaime "嘿。" nointeract

# game/script.rpy:169643
translate chinese Fortaime1_map012_7_0_8811bfd3:

    # voice "se/y00319.ogg"
    # char_fortaime "Wait, is this like a job interview or something?\nI've never been very good at \"selling\" myself.\nFirst and foremost though, I'd reconnect with the spirits."
    voice "se/y00319.ogg"
    char_fortaime "等等，这算是面试之类的吗？\n我一直不太擅长“推销”自己。\n不过首先，我会重新连接灵。"

# game/script.rpy:169649
translate chinese Fortaime1_map012_7_0_a7ae09dc:

    # voice "se/y00320.ogg"
    # char_fortaime "That way, Valinorth wouldn't freeze over.\nA lot of people forget it's the spirits that keep us warm.\nAfter that, I guess I'd focus on what to do with the people."
    voice "se/y00320.ogg"
    char_fortaime "这样，瓦利诺斯就不会冻住了。\n很多人忘了是灵让我们保持温暖。\n之后，我想我会专注于如何安置人民。"

# game/script.rpy:169671
translate chinese Fortaime2_map012_7_0_1b12f51c:

    # voice "se/y00321.ogg"
    voice "se/y00321.ogg"

# game/script.rpy:169673
translate chinese Fortaime2_map012_7_0_bb67d007:

    # char_fortaime "Actually, I'm not too sure about that.\nBut we're about to go on a huge journey.\nI'll make sure to pay attention along the way."
    char_fortaime "其实，这个我不太确定。\n但我们即将踏上一次巨大的旅程。\n我会一路留心。"

# game/script.rpy:169678
translate chinese Fortaime2_map012_7_0_9c467b02:

    # voice "se/y00322.ogg"
    # char_fortaime "If the connection can be taken away, it can be given back.\nThere's nothing that says this is a one way street.\nSo take care of that power until we can put it back!" nointeract
    voice "se/y00322.ogg"
    char_fortaime "如果这份联系能被夺走，就也能被归还。\n没谁说这是条单行道。\n所以在我们能还回去之前，好好保管那股力量！" nointeract

# game/script.rpy:169698
translate chinese Fortaime2_map012_7_0_f56571d7:

    # voice "se/y00323.ogg"
    # char_fortaime "That's the spirit!\nSaving Alestia comes first, but Valinorth is still important.\nThere has to be a way to do both at the same time, you know?"
    voice "se/y00323.ogg"
    char_fortaime "这才对！\n拯救阿莱斯蒂亚优先，但瓦利诺斯依然重要。\n总得有办法两件事同时兼顾，你知道吗？"

# game/script.rpy:169720
translate chinese Fortaime2_map012_7_0_98815917:

    # voice "se/y00324.ogg"
    # char_fortaime "What!? No way!\nYou might feel that way, but I don't.\nIf I were the Elder, I'd do anything to save Valinorth!"
    voice "se/y00324.ogg"
    char_fortaime "什么！？不可能！\n你也许那么想，但我不。\n如果我是长老，我会不惜一切拯救瓦利诺斯！"

