translate chinese click_map111_11_EV011_271dbb5a:

    # voice "se/w00265.ogg"
    voice "se/w00265.ogg"

# game/script.rpy:163080
translate chinese click_map111_11_EV011_06e7f953:

    # char_fortaime "Yeah?"
    char_fortaime "嗯？"

# game/script.rpy:163094
translate chinese click_map111_11_EV011_da5d1082:

