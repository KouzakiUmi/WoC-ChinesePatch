    char_jit_map114_1_0_29 "过去这玩意儿就是这样，莉莉丝。\n它总有办法追上你。"

# game/script.rpy:164439
translate chinese map114_0c90710f:

    # voice "se/x00280.ogg"
    voice "se/x00280.ogg"

