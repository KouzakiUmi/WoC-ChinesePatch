# game/script.rpy:169744
translate chinese Fortaime2_map012_7_0_fd193117:

    # char_fortaime "Well, we have an important choice to make.\nWe can follow after Mylus, and drop our independence.\nOr we can distance ourselves from the other nations, like always."
    char_fortaime "嗯，我们有个重要的选择要做。\n我们可以追随迈勒斯，放弃独立。\n或者像往常一样，与其他国家保持距离。"

# game/script.rpy:169749
translate chinese Fortaime2_map012_7_0_93d18045:

    # voice "se/y00326.ogg"
    # char_fortaime "Right now, I think unity is important.\nIf I were The Elder, I'd band our world together.\nWe could live in harmony, and trade freely!"
    voice "se/y00326.ogg"
    char_fortaime "现在，我觉得团结很重要。\n如果我是长老，我会把我们的世界凝聚在一起。\n我们可以和谐共处，自由通商！"

# game/script.rpy:169757
translate chinese Fortaime2_map012_7_0_08f93649:

    # voice "se/y00327.ogg"
    voice "se/y00327.ogg"

# game/script.rpy:169759
