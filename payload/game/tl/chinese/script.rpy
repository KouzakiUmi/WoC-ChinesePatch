translate chinese map023_bd0d0f4b:

    # char_jit_map023_1_0_16 "But that's what it was meant to be, Pro.\nThat's what The Rebellion wanted. Neutral ground for both nations.\nYou can't change your mind just because you want something else!"
    char_jit_map023_1_0_16 "可它本该就是那样的，普洛。\n那才是反抗军想要的。给两国中立的地盘。\n你不能因为想要别的东西就改变主意！"

# game/script.rpy:177128
translate chinese map023_ca3e036d:

    # voice "se/z00523.ogg"
    voice "se/z00523.ogg"

# game/script.rpy:177130
