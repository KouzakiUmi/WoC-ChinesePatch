    # char_valessa "This is a matter of Valinorth's future.\nSuch things are under the jurisdiction of the Seeress.\nI stand by her side, and you stand by both of ours."
    char_valessa "这关乎瓦利诺斯的未来。\n这类事情归先知管辖。\n我站在她这边，而你站在我们两人这边。"

# game/script.rpy:4525
translate chinese map037_9aaca339_1:

    # voice "se/z00103.ogg"
    # char_valessa "That is, unless you want to abandon your job.\nBut that wouldn't look good on your perfect record."
    voice "se/z00103.ogg"
    char_valessa "当然，除非你想撂挑子不干。\n可那会有损你完美的履历。"

# game/script.rpy:4553
translate chinese map037_ea11027e:

    # voice "se/z00104.ogg"
    voice "se/z00104.ogg"

