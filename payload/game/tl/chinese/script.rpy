    # voice "se/a00024.ogg"
    voice "se/a00024.ogg"

# game/script.rpy:190804
translate chinese click_map088_120_EV120_e42b7ab3:

    # char_fortaime "You bet! It's supposed to be the party of a lifetime!\nQuite literally, as there's only one Seer or Seeress per generation.\nIf I were you, I wouldn't make any important plans tomorrow."
    char_fortaime "那当然！这可是号称一生只有一次的派对！\n名副其实，因为每一代只有一位先知。\n要是我，明天绝不会安排任何重要的事。"

# game/script.rpy:190809
translate chinese click_map088_120_EV120_c4ef9686:

    # voice "se/a00025.ogg"
    voice "se/a00025.ogg"

# game/script.rpy:190812
