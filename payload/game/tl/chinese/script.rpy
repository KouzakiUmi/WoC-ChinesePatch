translate chinese map301_7d530f21:

    # voice "se/z02751.ogg"
    # char_jit_map301_1_0_342 "Then we die with honor.\nWe fight to the bitter end."
    voice "se/z02751.ogg"
    char_jit_map301_1_0_342 "那我们就光荣赴死。\n我们战斗到最后一刻。"

