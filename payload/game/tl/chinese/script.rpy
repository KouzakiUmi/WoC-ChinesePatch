# game/script.rpy:125032
translate chinese map204_43e401a1:

    # voice "se/x00401b.ogg"
    # char_the_triumvirate "Grand Inquisitor. Please rise."
    voice "se/x00401b.ogg"
    char_the_triumvirate "大审判官。请起身。"

# game/script.rpy:125047
translate chinese map204_ba8ed209:

    # "They say it again, and Halin looks around, confused.{w}\nA few moments later, he rises, standing up beside Sovy."
    "他们又说了一遍，哈林茫然地环顾四周。{w}\n片刻之后，他站了起来，站到索维身旁。"

# game/script.rpy:125072
translate chinese map204_5c73ff94:

    # voice "se/x00402.ogg"
    # char_halin "Masters...?"
    voice "se/x00402.ogg"
    char_halin "主人们……？"

# game/script.rpy:125098
translate chinese map204_988098a2:

    # voice "se/x00403.ogg"
    # char_the_triumvirate "Sovy is hereby stripped of the rank of Grand Inquisitor.\nHalin, taking this mantle, you will train Shane as your Apprentice.\nWe trust that you will do as we command, and avoid letting us down."
    voice "se/x00403.ogg"
    char_the_triumvirate "索维就此被剥夺大审判官的职衔。\n哈林，由你接过这个职位，你要把肖恩培养成你的学徒。\n我们相信你会照我们的命令行事，不会让我们失望。"

# game/script.rpy:125113
translate chinese map204_f7eb4bc6:

    # "Sovy takes a few steps back, while Halin nods."
    "索维后退了几步，哈林则点了点头。"

# game/script.rpy:125138
translate chinese map204_0281ef6a:

    # voice "se/x00404.ogg"
    # char_sovy "Please Masters, I beg you to reconsider.\nWe have them in our grasp! We can do this...!"
    voice "se/x00404.ogg"
    char_sovy "求你们，主人们，我请求你们重新考虑。\n他们已在我们掌中！我们能做到的……！"

# game/script.rpy:125164
translate chinese map204_3068c3ec:

    # voice "se/x00405.ogg"
    # char_the_triumvirate "Sovy, we would have understood the failure of your mission.\nBut lying to us...? The lack of loyalty and honesty is unacceptable.\nIt's almost starting to seem like your allegiance lies somewhere else."
    voice "se/x00405.ogg"
    char_the_triumvirate "索维，任务失败我们本可以理解。\n但对我们撒谎……？这种缺乏忠诚与坦诚的行为不可接受。\n这几乎开始让人觉得，你的忠心另有所属。"

# game/script.rpy:125180
translate chinese map204_0790e9ee:

    # voice "se/x00406.ogg"
    # char_sovy "It doesn't, I swear!"
    voice "se/x00406.ogg"
    char_sovy "没有，我发誓！"

# game/script.rpy:125206
translate chinese map204_f5f22774:

    # voice "se/x00407.ogg"
    # char_the_triumvirate "We cannot be certain that you're telling the truth.\nSurely you can see how that lie has damaged our trust.\nHalin, however, has proven to be nothing but loyal."
    voice "se/x00407.ogg"
    char_the_triumvirate "我们无法确定你说的是真话。\n你当然看得出，那个谎言如何损害了我们的信任。\n而哈林，已经证明了自己只有忠诚。"

# game/script.rpy:125210
translate chinese map204_db70265b:

    # voice "se/x00408.ogg"
    # char_the_triumvirate "Shane killed a key member of The Rebellion, as well.\nYou come back to us with nothing to show but deception.\nIt hurts us, and so you must be punished for your actions."
    voice "se/x00408.ogg"
    char_the_triumvirate "肖恩还杀掉了一名反抗军的重要成员。\n而你回来时，除了欺骗，一无所有。\n这让我们痛心，所以你必须为自己的所作所为受到惩罚。"

# game/script.rpy:125225
translate chinese map204_66ceb6db:

    # "Sovy's head slumps down, accepting defeat.{w}\nIf he wanted to win them back, he'd have to endure this punishment.{w}\nFighting it was useless, and would only serve to make things worse for him."
    "索维垂下头，接受了失败。{w}\n若想重新赢回他们的心，他就必须忍受这惩罚。{w}\n反抗毫无用处，只会让他的处境更糟。"

# game/script.rpy:125250
translate chinese map204_ad277946:

    # voice "se/x00409.ogg"
    # char_sovy "Very well, I understand.\nBut know that I {i}will{/i} make this up to you.\nUntil you need me again, I'll be in my chambers."
    voice "se/x00409.ogg"
    char_sovy "很好，我明白了。\n但你们要知道，我{i}一定会{/i}补偿你们。\n在你们再次需要我之前，我会待在自己的房间里。"

# game/script.rpy:125265
translate chinese map204_76fd4157:

    # "He starts to walk away, but is quickly stopped by his masters."
    "他转身要走，却被主人们迅速叫住。"

# game/script.rpy:125280
translate chinese map204_1de19084:

    # voice "se/x00410.ogg"
    # char_the_triumvirate "No."
    voice "se/x00410.ogg"
    char_the_triumvirate "不。"

# game/script.rpy:125295
translate chinese map204_7c285c40:

    # "Turning around, the look of anger is more apparent on his face."
    "他转过身来，脸上的怒意更加明显。"

# game/script.rpy:125320
translate chinese map204_8b2aa54f:

    # voice "se/x00411.ogg"
    # char_sovy "Excuse me...?"
    voice "se/x00411.ogg"
    char_sovy "你说什么……？"

# game/script.rpy:125346
translate chinese map204_d597e78d:

    # voice "se/x00412.ogg"
    # char_the_triumvirate "Your punishment must be rather severe.\nWithout that blade, we are vulnerable."
    voice "se/x00412.ogg"
    char_the_triumvirate "你的惩罚必须相当严厉。\n没有那把剑，我们就很脆弱。"

# game/script.rpy:125372
translate chinese map204_614b2cc0:

    # voice "se/x00413.ogg"
    # char_sovy "Then tell me what you plan to do.\nThere is no pain I will not endure for you."
    voice "se/x00413.ogg"
    char_sovy "那就告诉我你们打算怎么做。\n为了你们，任何痛苦我都愿意承受。"

# game/script.rpy:125398
translate chinese map204_efe0ee9b:

    # voice "se/x00413b.ogg"
    # char_the_triumvirate "Halin, Shane — come here."
    voice "se/x00413b.ogg"
    char_the_triumvirate "哈林，肖恩——过来。"

# game/script.rpy:125413
translate chinese map204_c4ccb32f:

    # "Doing as instructed, they approach The Triumvirate.{w}\nThey turn around, and Sovy is faced by all five of his now superiors."
    "他们依言走向三人执政团。{w}\n他们转过身，索维面对着如今全都成了他上级的五个人。"

# game/script.rpy:125438
translate chinese map204_88a01197:

    # voice "se/x00415.ogg"
    # char_the_triumvirate "We no longer have any use for you, Sovy.\nThe Inquisition has been reformed, and is now stronger.\nWe have no choice but to exile you from Balteus. Permanently."
    voice "se/x00415.ogg"
    char_the_triumvirate "索维，我们不再需要你了。\n审判庭已经改革，如今更加强大。\n我们别无选择，只能将你逐出巴尔泰乌斯。永久驱逐。"

# game/script.rpy:125464
translate chinese map204_7d70d2c1:

    # voice "se/x00416.ogg"
    # char_sovy "What!?"
    voice "se/x00416.ogg"
    char_sovy "什么！？"

# game/script.rpy:125490
translate chinese map204_12bf5c5f:

    # voice "se/x00417.ogg"
    # char_the_triumvirate "You will leave immediately.\nThis is non-negotiable — set in stone."
    voice "se/x00417.ogg"
    char_the_triumvirate "你必须立刻离开。\n这没有商量的余地——已成定局。"

# game/script.rpy:125505
translate chinese map204_f03cbdfe:

    # "Sovy shakes his head, clearly fighting back tears."
    "索维摇了摇头，显然在强忍着泪水。"

# game/script.rpy:125530
translate chinese map204_1412a6d8:

    # voice "se/x00418.ogg"
    # char_sovy "After everything I've done for you...?\nYou're going to what — just throw me away!?"
    voice "se/x00418.ogg"
    char_sovy "我为你们做了这么多……？\n你们竟然要——就这样把我扔掉！？"

# game/script.rpy:125556
translate chinese map204_57988999:

    # voice "se/x00419.ogg"
    # char_the_triumvirate "Yes. With our reign in danger, we need a strong core.\nWe need men who get the job done, without question.\nThis is something you seem to be incapable of, Sovy."
    voice "se/x00419.ogg"
    char_the_triumvirate "没错。我们的统治岌岌可危，需要一个强大的核心。\n我们需要的是不问缘由、把事办成的人。\n索维，这似乎正是你做不到的。"

# game/script.rpy:125572
translate chinese map204_06cf0a1b:

    # voice "se/x00420.ogg"
    # char_sovy "There must be something I can do..."
    voice "se/x00420.ogg"
    char_sovy "一定有什么我能做的……"

# game/script.rpy:125600
translate chinese map204_3a5d930a:

    # voice "se/x00421.ogg"
    voice "se/x00421.ogg"

# game/script.rpy:125602
translate chinese map204_fc36fa97:

    # char_the_triumvirate "No, Sovy. There's nothing you can do. It's too late.\nUnless you march in here with that blade {i}and{/i} The Seer?\nWell, to put it bluntly, we never wish to see your face again."
    char_the_triumvirate "不，索维。你什么也做不了。太迟了。\n除非你能带着那把剑{i}和{/i}先知走进这里？\n说白了，我们永远不想再见到你的脸。"

# game/script.rpy:125607
translate chinese map204_44589c51:

    # voice "se/x00422.ogg"
    voice "se/x00422.ogg"

# game/script.rpy:125609
translate chinese map204_4782f832:

    # char_the_triumvirate "No, Sovy. There's nothing you can do. It's too late.\nUnless you march in here with that blade {i}and{/i} The Seeress?\nWell, to put it bluntly, we never wish to see your face again."
    char_the_triumvirate "不，索维。你什么也做不了。太迟了。\n除非你能带着那把剑{i}和{/i}先知走进这里？\n说白了，我们永远不想再见到你的脸。"

# game/script.rpy:125642
translate chinese map205_660f424a:

    # "Ulric sits at the tavern, taking large swigs of ale.{w}\nIt's hard to accept that if we sided with Draycu, he'd be against us.{w}\nBut it's understandable, as well. He really wanted to change Alarinthia."
    "乌尔里克坐在酒馆里，大口灌着麦酒。{w}\n想到如果我们站在德雷库那边，他就会与我们为敌，实在难以接受。{w}\n但这也情有可原。他真的太想改变阿拉林西亚了。"

# game/script.rpy:125644
translate chinese map205_74261101:

    # "I hope that this wouldn't affect The Rebellion, and our unity.{w}\nWe can't have our key members being at arms with each other."
    "我希望这不会影响到反抗军，还有我们的团结。{w}\n我们的核心成员可不能彼此兵戎相见。"

# game/script.rpy:125669
translate chinese map205_7bcb2936:

    # voice "se/y01337.ogg"
    voice "se/y01337.ogg"

# game/script.rpy:125671
translate chinese map205_fe70f792:

    # char_ulric "Have a seat, [firstname]. These drinks are on me.\nI don't want you filling up on Draycu's handouts."
    char_ulric "坐吧，[firstname]。这些酒我请。\n我可不想让你被德雷库的小恩小惠喂饱。"

# game/script.rpy:125685
translate chinese map205_8c92b739:

    # "I nod, and take a seat beside him. I'll drink, but I want some answers.{w}\nHis hasty alliance with Vivien, the lies about his markings, and his past.{w}\nIf he wants my trust, then he needs to tell me everything. I feel lost."
    "我点点头，在他身旁坐下。酒我会喝，但我要一些答案。{w}\n他与薇薇安仓促结盟、关于他身上刺青的谎言，还有他的过去。{w}\n他若想要我的信任，就得把一切都告诉我。我感到迷茫。"

# game/script.rpy:125687
translate chinese map205_a35a3d1e:

    # "I voice those concerns to him, as the drink he ordered me arrives.{w}\nTaking a large swig, I sit back and await his response, whatever it may be."
    "他为我点的酒送来时，我把这些疑虑说了出来。{w}\n我灌了一大口，靠回椅背，等待他的回应，无论是什么。"

# game/script.rpy:125712
translate chinese map205_e1dbe47f:

    # voice "se/y01338.ogg"
    # char_ulric "Trust? This isn't about trust, [firstname].\nYour trust in me won't affect {i}any{/i} of your decisions.\nIn fact, we could win this war without any trust at all."
    voice "se/y01338.ogg"
    char_ulric "信任？这跟信任无关，[firstname]。\n你对我的信任不会影响你{i}任何{/i}一个决定。\n事实上，我们完全没有信任也能打赢这场战争。"

# game/script.rpy:125716
translate chinese map205_1e0f6a78:

    # voice "se/y01339.ogg"
    # char_ulric "All that matters is the desire to fight for a common cause.\nDid you think that these little chats we've been having were mandatory?\nTrust me — I could've done just fine without them. In fact, I'd be better off."
    voice "se/y01339.ogg"
    char_ulric "真正重要的，是为共同目标而战的意愿。\n你以为我们这些闲聊是必需的吗？\n相信我——没有它们我照样能行。事实上，我会过得更好。"

# game/script.rpy:125731
translate chinese map205_01944f27:

    # "I'm taken aback by his harsh words.{w}\nBut I don't let it provoke me. I simply wait.{w}\nIt's best if I let him get a clear head instead."
    "他刻薄的话让我一愣。{w}\n但我没有被激怒。我只是等着。{w}\n最好还是让他自己冷静下来。"

# game/script.rpy:125756
translate chinese map205_d48f160b:

    # voice "se/y01340.ogg"
    # char_ulric "I'm sorry. I didn't mean that..."
    voice "se/y01340.ogg"
    char_ulric "抱歉。我不是那个意思……"

# game/script.rpy:125772
translate chinese map205_d6528f5b:

    # voice "se/y01341.ogg"
    voice "se/y01341.ogg"

# game/script.rpy:125774
translate chinese map205_fbc298ef:

    # char_ulric "It's just — the feelings I have for you, they complicate things.\nHarmless fun, I know that's what we said; but look at me now.\nI'm scared that if I tell you everything, you'll turn your back to me."
    char_ulric "只是——我对你的感情，让事情变复杂了。\n无伤大雅的玩乐，我知道我们当初是这么说的；可看看我现在的样子。\n我怕一旦把一切都告诉你，你就会转身离开我。"

# game/script.rpy:125779
translate chinese map205_7a88c69f:

    # voice "se/y01342.ogg"
    voice "se/y01342.ogg"

# game/script.rpy:125781
translate chinese map205_d7040a4e:

    # char_ulric "This friendship we're forming complicates things.\nThere's a reason I never kept many friends, Monarch.\nI'm scared that if I tell you everything, you'll just walk away."
    char_ulric "我们正在建立的这份友谊，让事情变复杂了。\n君主，我从不交太多朋友，是有原因的。\n我怕一旦把一切都告诉你，你就会一走了之。"

# game/script.rpy:125795
translate chinese map205_a6e94e12:

    # voice "se/y01343.ogg"
    voice "se/y01343.ogg"

# game/script.rpy:125797
translate chinese map205_373523e2:

    # char_ulric "Spirits know everybody else did.\nHeh. Look at me, still using superstition.\nThe spirits had no power over us — no divine plan."
    char_ulric "神灵作证，其他人都这么做过。\n呵。看看我，还在用这种迷信的说法。\n神灵对我们毫无掌控——不存在什么神圣的安排。"

# game/script.rpy:125800
translate chinese map205_2be42cef:

    # voice "se/y01344.ogg"
    # char_ulric "Then why do I find myself still wanting to believe in them?\nI guess maybe they gave me a sense of comfort in difficult times.\nIt's different now — having difficult times — and knowing the truth."
    voice "se/y01344.ogg"
    char_ulric "那为什么我发现自己还是想相信它们？\n我想，也许在艰难的岁月里，它们曾给过我一丝慰藉。\n现在不一样了——身处艰难之中，却已知道真相。"

# game/script.rpy:125814
translate chinese map205_d2a2632b:

    # voice "se/y01345.ogg"
    # char_ulric "What do I believe in, if I want to push myself forward...?\nThat's what made me want to side with Vivien, no matter what.\nThe desire to change my nation is what drives me to action, now."
    voice "se/y01345.ogg"
    char_ulric "若想逼自己向前走，我该信什么……？\n正因如此，我才决心无论如何都要站在薇薇安这边。\n如今驱使着我行动的，是改变我祖国的渴望。"

# game/script.rpy:125818
translate chinese map205_fe7c2307:

    # voice "se/y01346.ogg"
    # char_ulric "And when we're done here, it'll be the desire to change our world.\nThat's all I've wanted, my entire life. It always seems just out of reach.\nWhenever I think I have it — The Triumvirate swoops in and takes it away."
    voice "se/y01346.ogg"
    char_ulric "等我们了结这里的事，那就会变成改变我们整个世界的渴望。\n这是我一生唯一的所求。它却总像是差一点点才够得着。\n每当我以为自己抓住了它——三人执政团就扑过来把它夺走。"

# game/script.rpy:125822
translate chinese map205_d47d3e7b:

    # voice "se/y01347.ogg"
    # char_ulric "They tell you they'll give you what you want.\nThey convince you that they'll make your dreams come true.\nThen — when they're done with you — they throw you away."
    voice "se/y01347.ogg"
    char_ulric "他们告诉你，他们会给你想要的一切。\n他们让你相信，他们会让你梦想成真。\n然后——等利用完你——就把你扔掉。"

# game/script.rpy:125837
translate chinese map205_6fecbed8:

    # "He lets out a loud sigh, and slumps down in his chair.{w}\nI'm not sure why he's telling me all of this, but I still listen.{w}\nEven if it's somewhat unrelated, it's helpful for him to vent."
    "他长叹一声，瘫坐在椅子里。{w}\n我不确定他为什么要把这些全告诉我，但我还是听着。{w}\n就算有点不相关，让他发泄出来也是好事。"

# game/script.rpy:125865
translate chinese map205_9712253f:

    # voice "se/y01348.ogg"
    # char_ulric "What I'm about to tell you, I tell you in confidence.\nI knew Sovy, before he became The Grand Inquisitor.\nThat's how I know so much about The Triumvirate."
    voice "se/y01348.ogg"
    char_ulric "接下来我要告诉你的，是私下跟你说的。\n在索维成为大审判官之前，我就认识他。\n所以我才对三人执政团了解这么多。"

# game/script.rpy:125872
translate chinese map205_96a76c62:

    # voice "se/y01349.ogg"
    # char_ulric "I saw them take an impressionable young man, and ruin him.\nTurn him into a tool meant to kill without a second thought.\nThey took my friend, and after that, he was no more."
    voice "se/y01349.ogg"
    char_ulric "我眼看着他们把一个易受影响的年轻人带走，然后毁了他。\n把他变成一件用来毫不犹豫杀人的工具。\n他们夺走了我的朋友，从那以后，他就不复存在了。"

# game/script.rpy:125876
translate chinese map205_da65f265:

    # voice "se/y01350.ogg"
    # char_ulric "That monster we fight may look like my friend.\nBut that man is long gone. They made sure of that.\nI promised myself I'd never let them do that again."
    voice "se/y01350.ogg"
    char_ulric "我们对抗的那个怪物，也许长得像我的朋友。\n但那个人早已不在了。是他们亲手造成的。\n我向自己发过誓，绝不让这种事重演。"

# game/script.rpy:125880
translate chinese map205_6b22f614:

    # voice "se/y01351.ogg"
    # char_ulric "I failed. They got to Shane, just like they got to Sovy.\nIt's almost impossible to shake off their influence.\nThey just have this way of... \"convincing\" you."
    voice "se/y01351.ogg"
    char_ulric "我失败了。他们拉拢了肖恩，就像拉拢索维一样。\n他们的影响几乎无法摆脱。\n他们就是有办法……把你“说服”。"

# game/script.rpy:125895
translate chinese map205_65887746:

    # "I continue listening, and we take turns drinking.{w}\nSoon after, a second drink comes for each of us.{w}\nI believe every word. I knew there was a connection."
    "我继续听着，我们轮流喝酒。{w}\n没过多久，我们各自又来了第二杯。{w}\n他说的每一个字我都信。我早知道他们之间有某种关联。"

# game/script.rpy:125897
translate chinese map205_b263480c:

    # "I look back to the vision I had of Valinorth's destruction.{w}\nThey said some things that revealed a connection between them.{w}\nBut I just assumed it was something rivals developed in wartime."
    "我回想起曾看到的瓦利诺斯覆灭的幻象。{w}\n他们说过一些话，暴露出彼此之间有所关联。{w}\n但我当时只当那是宿敌在战争中产生的默契。"

# game/script.rpy:125899
translate chinese map205_d8f6267e:

    # "However, to think that Sovy was once good...?{w}\nThat's the part I find hard to believe about all of this.{w}\nYet — he spared me, when he had my life in his hands."
    "可是，要说索维曾经也是个好人……？{w}\n这整件事里，我最难相信的就是这一点。{w}\n然而——当我的性命握在他手里时，他放过了我。"

# game/script.rpy:125924
translate chinese map205_03d8ff0b:

    # voice "se/y01352.ogg"
    # char_ulric "Well, that's one of the things I had to tell you.\nIt was a long time ago, but it still happened.\nI won't let it get in the way of my performance."
    voice "se/y01352.ogg"
    char_ulric "嗯，这就是我必须告诉你的事情之一。\n那是很久以前的事了，但它确实发生过。\n我不会让它影响我的表现。"

# game/script.rpy:125928
translate chinese map205_2e4ed4a3:

    # voice "se/y01353.ogg"
    # char_ulric "A long time ago, I thought maybe I could win him back.\nYou know — maybe he could change, and redeem himself.\nBut I haven't thought that in a long time. Now, I want to kill him."
    voice "se/y01353.ogg"
    char_ulric "很久以前，我想过也许能把他拉回来。\n你知道的——也许他能改变，能自我救赎。\n但我已经很久没这么想过了。现在，我想杀了他。"

# game/script.rpy:125932
translate chinese map205_7219488d:

    # voice "se/y01354.ogg"
    # char_ulric "For everything he's done to me. For everything he's done to us.\nThere's a point where redemption eludes you, and he's past that.\nI guess this leads into the second thing I wanted to tell you, [firstname]."
    voice "se/y01354.ogg"
    char_ulric "为了他对我做的一切。为了他对我们做的一切。\n总有那么一个点，救赎再也无从谈起，而他早已越过。\n我想，这就引出了我想告诉你的第二件事，[firstname]。"

# game/script.rpy:125946
translate chinese map205_dfb5c573:

    # voice "se/y01355.ogg"
    # char_ulric "Back in the desert, I told you about how I got these markings.\nThen Drakeor said I ripped them off from the ancient Alarinthians.\nI wish that was the truth, I really do — but it's not the truth at all."
    voice "se/y01355.ogg"
    char_ulric "在沙漠里的时候，我跟你说过这些刺青是怎么来的。\n后来德雷克说，我是从古代阿拉林西亚人那里剽窃来的。\n我真希望那是真的，真心希望——可那根本不是真相。"

# game/script.rpy:125950
translate chinese map205_b7a4c35b:

    # voice "se/y01356.ogg"
    # char_ulric "I always tell people that I'm older than they think.\nBut I only say that to hide how old I really am.\nIt's not a lie — it's more like an omission."
    voice "se/y01356.ogg"
    char_ulric "我总是跟人说，我比他们想象的要年长。\n但我这么说，只是为了掩盖我真正的年纪。\n这不算撒谎——更像是一种隐瞒。"

# game/script.rpy:125965
translate chinese map205_5381be91:

    # "He rests his head in his hands, his second glass now empty."
    "他把头埋进双手里，第二杯酒已经见底。"

# game/script.rpy:125980
translate chinese map205_7646f014:

    # voice "se/y01357.ogg"
    # char_ulric "I'm old enough to have earned these markings the {i}right{/i} way.\nThere — I said it. I don't care if you believe me, or not. I finally said it.\nI'm older than any of you could've possibly imagined. Very, very, old."
    voice "se/y01357.ogg"
    char_ulric "我老到足以用{i}正当{/i}的方式赢得这些刺青。\n好了——我说出来了。你信不信我，我不在乎。我终于说出来了。\n我比你们任何人能想象到的都要老。非常、非常老。"

# game/script.rpy:125995
translate chinese map205_28cd7fdc:

    # "I am so confused right now. He's claiming to be thousands of years old...?{w}\nAs far as I knew, the laws that led to those markings were banned long ago.{w}\nBut not only that, he also used to work with Sovy? I'd say he's our mortal enemy."
    "我现在一头雾水。他在声称自己有几千岁……？{w}\n据我所知，催生那些刺青的律法早就被废除了。{w}\n可不仅如此，他还曾经和索维共事过？要我说，他就是我们的死敌。"

# game/script.rpy:126020
translate chinese map205_390f8365:

    # voice "se/y01358.ogg"
    # char_ulric "Go ahead, tell me you don't believe me.\nSo far, nobody else has. They say it's \"impossible\".\nAnd soon after that, they say nothing to me at all." nointeract
    voice "se/y01358.ogg"
    char_ulric "来吧，说你不信我。\n到目前为止，没有一个人信。他们都说这“不可能”。\n再过不久，他们索性就不跟我说话了。" nointeract

# game/script.rpy:126036
translate chinese map205_ffbb8b94:

    # voice "se/y01359.ogg"
    # char_ulric "Really...? You'd be the first.\nOf course, there was always something different about you.\nNow that we've been through all of this, we finally know why."
    voice "se/y01359.ogg"
    char_ulric "真的……？那你可是头一个。\n当然，你身上一直有些与众不同之处。\n如今我们一起经历了这一切，我们终于知道原因了。"

# game/script.rpy:126040
translate chinese map205_821c1a24:

    # voice "se/y01360.ogg"
    # char_ulric "Thank you [firstname], I really mean it.\nThere's more to this story, but that's all we have time for.\nIt's just the basics. Stuff you'll {i}need{/i} to know moving forward."
    voice "se/y01360.ogg"
    char_ulric "谢谢你，[firstname]，我是真心的。\n这故事还有更多，但我们只有时间讲到这里了。\n这些只是基础。是你继续前行时{i}必须{/i}知道的东西。"

# game/script.rpy:126058
translate chinese map205_bca5f8f8:

    # voice "se/y01361.ogg"
    # char_ulric "Heh — you can never turn off that charm, huh?\nWell, in any case, I'm glad you believe me. Most people don't.\nThere's something different about you, though, so I took a leap of faith."
    voice "se/y01361.ogg"
    char_ulric "呵——你这股魅力总是关不掉，是吧？\n总之，我很高兴你信我。大多数人都不信。\n不过，你确实有些与众不同，所以我才冒险赌了一把。"

# game/script.rpy:126062
translate chinese map205_8eacbee1:

    # voice "se/y01362.ogg"
    # char_ulric "Thank you [firstname], I really mean it.\nThere's more to this story, but that's all we have time for.\nIt's just the basics. Stuff you'll {i}need{/i} to know before moving forward."
    voice "se/y01362.ogg"
    char_ulric "谢谢你，[firstname]，我是真心的。\n这故事还有更多，但我们只有时间讲到这里了。\n这些只是基础。是你继续前行之前{i}必须{/i}知道的东西。"

# game/script.rpy:126078
translate chinese map205_b740f861:

    # voice "se/y01363.ogg"
    # char_ulric "Right, of course — it's not true.\nJust the alcohol talking, like normal.\nForget I mentioned anything, alright?"
    voice "se/y01363.ogg"
    char_ulric "对，当然——那不是真的。\n跟平常一样，只是喝多了胡言乱语。\n就当我没提过任何事，好吗？"

# game/script.rpy:126094
translate chinese map205_fb71c7ec:

    # voice "se/y01364.ogg"
    # char_ulric "It was really tough, yeah.\nBut not as tough as what happened at our HQ.\nSeeing him treat us all with such malice made me sick."
    voice "se/y01364.ogg"
    char_ulric "确实很难熬。\n但比不上在总部发生的事那么难熬。\n看到他那样满怀恶意地对待我们，让我恶心。"

# game/script.rpy:126098
translate chinese map205_9490e894:

    # voice "se/y01365.ogg"
    # char_ulric "Any semblance of the man I knew before is long gone.\nIt's weird — mourning someone when they're still alive.\nThanks for listening to me, [firstname]. Not many do."
    voice "se/y01365.ogg"
    char_ulric "我从前认识的那个人的影子，早已荡然无存。\n真奇怪——人还活着，却要为他哀悼。\n谢谢你听我说这些，[firstname]。没几个人愿意。"

# game/script.rpy:126114
translate chinese map205_679bc63e:

    # voice "se/y01366.ogg"
    # char_ulric "Of course, it was my pleasure.\nMost people cut me off before I can finish.\nThey call me childish, and say I'm making it all up."
    voice "se/y01366.ogg"
    char_ulric "当然，这是我的荣幸。\n大多数人还没等我说完就打断我。\n他们说我幼稚，说这一切都是我编的。"

# game/script.rpy:126118
translate chinese map205_8449d72f:

    # voice "se/y01367.ogg"
    # char_ulric "I hope in time, I can prove that it's true.\nOf course, something like that is never easy.\nThere's more, but I can tell you that another time."
    voice "se/y01367.ogg"
    char_ulric "我希望有朝一日能证明这是真的。\n当然，这种事从来都不容易。\n还有更多，但我可以改天再告诉你。"

# game/script.rpy:126135
translate chinese map205_13a2266a:

    # "The barkeep comes up to us and asks if we want another drink.{w}\nUlric shakes his head, sending him off on his way, and puts some money down."
    "酒保走过来，问我们要不要再来一杯。{w}\n乌尔里克摇了摇头，把他打发走，在桌上放了些钱。"

# game/script.rpy:126148
translate chinese map205_52aa8500:

    # voice "se/y01368.ogg"
    # char_ulric "My treat, remember?\nNow let's get going to that ball.\nTonight, we change history."
    voice "se/y01368.ogg"
    char_ulric "说了我请客，记得吗？\n现在，我们去舞会吧。\n今晚，我们要改写历史。"

# game/script.rpy:126160
translate chinese map205_a54b1ba5:

    # "Ulric's loyalty scene will be available when you return to the mainland.{w}\nThe game will notify you when the loyalty scenes have been unlocked.{w}\nWhen they have been — you can view them by going to the War Table."
    "等你回到大陆，乌尔里克的忠诚剧情就会解锁。{w}\n忠诚剧情解锁时，游戏会通知你。{w}\n解锁之后——你可以前往作战桌查看。"

# game/script.rpy:126405
translate chinese click_map181_15_EV015_04ffd5db:

    # "You allied yourself with Vivien in the Coliseum."
    "你在竞技场与薇薇安结盟。"

# game/script.rpy:126412
translate chinese click_map181_15_EV015_9e16c7b9:

    # "You allied yourself with Draycu in the coliseum."
    "你在竞技场与德雷库结盟。"

# game/script.rpy:126462
translate chinese map184_081511c1:

    # "We enter the castle gates, and to my surprise, I see trees like back at home.{w}\nThere's grass, too. Almost as green as the grass back in Valinorth.{w}\nI have no idea how Draycu got this here, but it sure wasn't cheap."
    "我们走进城堡大门，令我惊讶的是，我看到了像家乡一样的树木。{w}\n还有草地。几乎和瓦利诺斯的草地一样翠绿。{w}\n我不知道德雷库是怎么把这些弄来的，但肯定花了不少钱。"

# game/script.rpy:126487
translate chinese map184_f47b6f26:

    # voice "se/z01791.ogg"
    voice "se/z01791.ogg"

# game/script.rpy:126489
translate chinese map184_c1835147:

    # char_valessa "Wow, this is incredible!\nI know you said he was rich, but this is crazy.\nI've never seen such a fancy place — not in my entire life!"
    char_valessa "哇，太不可思议了！\n我知道你说过他很有钱，但这也太夸张了。\n我这辈子都没见过这么气派的地方！"

# game/script.rpy:126503
translate chinese map184_270f0a32:

    # "Damek steps forward, clearly amazed as well."
    "达梅克走上前，显然也惊叹不已。"

# game/script.rpy:126525
translate chinese map184_86df689d:

    # voice "se/z01792.ogg"
    voice "se/z01792.ogg"

# game/script.rpy:126527
translate chinese map184_843f9042:

    # char_damek "So this is where Draycu lives, hmm...?\nIt seems a bit excessive, don't you think?\nI prefer our tunnels. A lot more secretive."
    char_damek "所以德雷库就住在这儿，嗯……？\n有点太过了，你不觉得吗？\n我还是更喜欢我们的地道。隐蔽多了。"

# game/script.rpy:126540
translate chinese map184_a1e9922d:

    # voice "se/z01793.ogg"
    # char_ulric "Alarinthia is all about showcasing your power.\nMost rulers add a wing or two to the castle during their reign.\nIt's only going to get bigger and bigger with each passing year."
    voice "se/z01793.ogg"
    char_ulric "阿拉林西亚讲究的就是炫耀权力。\n大多数统治者都会在位期间给城堡添上一两个侧翼。\n年复一年，它只会越来越大。"

# game/script.rpy:126544
translate chinese map184_b0a74b06:

    # voice "se/z01794.ogg"
    # char_ulric "Unless of course, Vivien takes over.\nHe's not fixated on that kind of stuff."
    voice "se/z01794.ogg"
    char_ulric "当然，除非薇薇安上台。\n他对这种东西可不痴迷。"

# game/script.rpy:126570
translate chinese map184_d380d9d1:

    # voice "se/z01795.ogg"
    # char_damek "I can't imagine it getting much bigger, to be honest.\nWhat does one ruler need to do with all that space...?"
    voice "se/z01795.ogg"
    char_damek "说实话，我想不出它还能大到哪里去。\n一个统治者要这么多空间干什么……？"

# game/script.rpy:126596
translate chinese map184_afd7dbc1:

    # voice "se/z01796.ogg"
    # char_ulric "Well, he has a large army as well.\nLarger than Vivien's — but don't let that sway us.\nI think you've seen enough to know that this place needs changing."
    voice "se/z01796.ogg"
    char_ulric "这个嘛，他还有一支庞大的军队。\n比薇薇安的还多——但别让这动摇我们。\n我想你看到的东西已经够多，足以明白这地方需要改变了。"

# game/script.rpy:126622
translate chinese map184_a3c6e7cc:

    # voice "se/z01797.ogg"
    # char_damek "Right, right. Of course.\nSo what, do we just march right in?\nI don't see any guards, or security."
    voice "se/z01797.ogg"
    char_damek "对，对。当然。\n那怎么办，我们就这么直接走进去？\n我没看到任何卫兵，也没看到守卫。"

# game/script.rpy:126644
translate chinese map184_79055427:

    # "I look around, and he's right. I just see lots of partygoers.{w}\nThey're all sipping some sort of alcohol, and they look at peace.{w}\nI suppose this is one way to stop the people from fighting back."
    "我环顾四周，他说得没错。我只看到一大堆参加宴会的人。{w}\n他们都在小口喝着某种酒，神情安逸。{w}\n我猜，这也算是一种让民众不再反抗的办法。"

# game/script.rpy:126646
translate chinese map184_22b9a346:

    # "I notice a large man exit the castle gates, and slowly approach us.{w}\nHe's not carrying any weapons, so I doubt he's some sort of security.{w}\nHe looks intimidating, of course, but that's about it. Is this Westy...?"
    "我注意到一个高大的男人从城堡大门走出来，缓缓朝我们靠近。{w}\n他身上没带武器，所以我不觉得他是守卫。{w}\n当然，他看起来很有威慑力，但也仅此而已。这就是韦斯蒂吗……？"

# game/script.rpy:126671
translate chinese map184_14973538:

    # voice "se/z01798.ogg"
    # char_ulric "I'll take care of this, just like before.\nWe can't risk slipping up in this castle.\nOne misstep, and everyone will be after us."
    voice "se/z01798.ogg"
    char_ulric "这里交给我，和之前一样。\n在这座城堡里，我们可不能出差错。\n一步走错，所有人都会追杀我们。"

# game/script.rpy:126686
translate chinese map184_2969bdcc:

    # "We all step back, trusting Ulric's word.{w}\nHe takes a few steps forward, meeting the mysterious man.{w}\nSomething tells me that this is Draycu's guard. I just know it."
    "我们都信任乌尔里克，向后退开。{w}\n他向前走了几步，与那个神秘男人会面。{w}\n我有种直觉，这就是德雷库的护卫。我就是知道。"

# game/script.rpy:126701
translate chinese map184_4dc0b70d:

    # voice "se/z01799.ogg"
    # char_ulric "Westy, I presume...?\nThat's an interesting name, you know."
    voice "se/z01799.ogg"
    char_ulric "我猜，你就是韦斯蒂……？\n你知道吗，这名字挺有意思的。"

# game/script.rpy:126727
translate chinese map184_3f69d919:

    # voice "se/z01800.ogg"
    voice "se/z01800.ogg"

# game/script.rpy:126733
translate chinese map184_2a44149a:

    # char_jit_map184_1_0_158 "It's a nickname, for your information.\nAnd you must be Ulric...? You sure stand out."
    char_jit_map184_1_0_158 "告诉你，那是个绰号。\n那你一定就是乌尔里克……？你可真显眼。"

# game/script.rpy:126758
translate chinese map184_66925b8c:

    # voice "se/z01801.ogg"
    # char_ulric "Yes. We come in peace, don't worry.\nWe're here for the ball, and Draycu.\nIs it possible to request an audience?"
    voice "se/z01801.ogg"
    char_ulric "没错。我们是为和平而来，别担心。\n我们来参加舞会，也要见德雷库。\n可以求见吗？"

# game/script.rpy:126784
translate chinese map184_7fd4e2d7:

    # voice "se/z01802.ogg"
    # char_jit_map184_1_0_158 "He's a busy man, you know."
    voice "se/z01802.ogg"
    char_jit_map184_1_0_158 "你知道的，他可是个大忙人。"

# game/script.rpy:126810
translate chinese map184_5e97c3f3:

    # voice "se/z01803.ogg"
    # char_ulric "So am I — so don't waste our time.\nCan we have an audience or not...?"
    voice "se/z01803.ogg"
    char_ulric "我也是——所以别浪费我们的时间。\n到底能不能见，就一句话……？"

# game/script.rpy:126825
translate chinese map184_f1f12642:

    # "Westy sighs, and crosses his arms."
    "韦斯蒂叹了口气，抱起了胳膊。"

# game/script.rpy:126850
translate chinese map184_45edb17f:

    # voice "se/z01804.ogg"
    # char_jit_map184_1_0_158 "Fine, fine. I'll let you in to see him.\nHe's been expecting you, you know.\nWe've been keeping watch since the docks."
    voice "se/z01804.ogg"
    char_jit_map184_1_0_158 "行，行。我放你们进去见他。\n你知道的，他一直在等你们。\n从码头起，我们就在盯着你们了。"

# game/script.rpy:126876
translate chinese map184_1dfad1cb:

    # voice "se/z01805.ogg"
    # char_ulric "Just like Vivien's man."
    voice "se/z01805.ogg"
    char_ulric "跟薇薇安的手下一样。"

# game/script.rpy:126902
translate chinese map184_1d05ec84:

    # voice "se/z01806.ogg"
    # char_jit_map184_1_0_158 "Yeah, but we let him get to you first.\nIt's not often an army comes here from the mainland.\nWe wanted to hear his offer, so we could top it."
    voice "se/z01806.ogg"
    char_jit_map184_1_0_158 "是啊，但我们先让他去接触你们。\n从大陆来一支军队，可不常有。\n我们想先听听他的开价，好压过他。"

# game/script.rpy:126928
translate chinese map184_bdddf9d4:

    # voice "se/z01807.ogg"
    # char_ulric "Top it...? Draycu wants our army as well?\nWe're starting to become popular around here."
    voice "se/z01807.ogg"
    char_ulric "压过他……？德雷库也想要我们的军队？\n我们在这儿开始抢手起来了。"

# game/script.rpy:126954
translate chinese map184_099c8a43:

    # voice "se/z01808.ogg"
    # char_jit_map184_1_0_158 "Don't let it get to your head, Ulric.\nYou're just as disposable to him as Vivien.\nYou just happen to be both disposable {i}and{/i} strong."
    voice "se/z01808.ogg"
    char_jit_map184_1_0_158 "别太得意，乌尔里克。\n在他眼里，你和薇薇安一样可有可无。\n只不过你恰好{i}既{/i}可有可无又够强。"

# game/script.rpy:126980
translate chinese map184_e5e75b17:

    # voice "se/z01809.ogg"
    # char_ulric "You might want to work on your public relations skills."
    voice "se/z01809.ogg"
    char_ulric "你也许该练练待人接物的本事。"

# game/script.rpy:127006
translate chinese map184_9c7f084b:

    # voice "se/z01810.ogg"
    # char_jit_map184_1_0_158 "Look at this ball, and then say that to me again.\nThat's right, you can't. Now let's get going.\nI'll be inside the gates when you're ready."
    voice "se/z01810.ogg"
    char_jit_map184_1_0_158 "看看这场舞会，再把那话对我说一遍。\n没错，你说不出来。现在走吧。\n你们准备好了就到门里找我。"

# game/script.rpy:127028
translate chinese map184_449f2d20:

    # "He walks away, leaving Ulric to turn back to us.{w}\nSo it seems like everybody has a use for us in this place.{w}\nVivien was probably right. Draycu would use us to fight him."
    "他转身离开，留下乌尔里克回过头来面向我们。{w}\n看来在这地方，人人都想利用我们。{w}\n薇薇安大概说对了。德雷库会用我们去对付他。"

# game/script.rpy:127053
translate chinese map184_e18f0c54:

    # voice "se/z01811.ogg"
    # char_ulric "Well that makes things easier, doesn't it?\nThis is going to go exactly like we expected.\nLet's just help Vivien and get this over with."
    voice "se/z01811.ogg"
    char_ulric "那反而让事情更简单了，不是吗？\n一切都会和我们预想的一模一样。\n我们就帮薇薇安，把这事了结掉吧。"

# game/script.rpy:127057
translate chinese map184_e83f3949:

    # voice "se/z01812.ogg"
    # char_ulric "Draycu has a bigger army, but Vivien has a brighter future.\nThat's what we're fighting for, remember? A better future.\nIt might be a bit harder to win, but we can still do it."
    voice "se/z01812.ogg"
    char_ulric "德雷库的军队更庞大，但薇薇安有更光明的未来。\n我们为之奋斗的不就是这个吗？一个更好的未来。\n要赢或许会难一些，但我们仍然做得到。"

# game/script.rpy:127072
translate chinese map184_fb84e9e7:

    # "Everybody nods, agreeing on this unanimously.{w}\nIt makes sense, since they didn't want to fight Ulric.{w}\nBut ultimately, the final decision would be up to me."
    "所有人都点头，一致同意。{w}\n这也说得通，因为他们不想与乌尔里克为敌。{w}\n但最终，最后的决定权还是在我手上。"

# game/script.rpy:127097
translate chinese map184_2ea98f10:

    # voice "se/z01813.ogg"
    voice "se/z01813.ogg"

# game/script.rpy:127099
translate chinese map184_8df453c9:

    # char_damek "This seems to be going pretty well...\nI hope we're not walking into a trap."
    char_damek "看起来进展挺顺利的……\n但愿我们不是在自投罗网。"

# game/script.rpy:127124
translate chinese map184_9601a694:

    # voice "se/z01814.ogg"
    # char_ulric "Draycu wouldn't try anything during his ball.\nThis is about making the people happy, not scared.\nLet's hear him out, and get this over with for good."
    voice "se/z01814.ogg"
    char_ulric "德雷库不会在自己的舞会上动手脚。\n这事关让民众开心，而不是让他们害怕。\n我们去听听他要说什么，把这事彻底了结。"

# game/script.rpy:127150
translate chinese map184_2debcb73:

    # voice "se/z01815.ogg"
    # char_damek "Sure, sounds good to me.\nOn your mark, [firstname]."
    voice "se/z01815.ogg"
    char_damek "行，我没意见。\n发令吧，[firstname]。"

# game/script.rpy:127177
translate chinese map184_6c363997:

    # "They all spread out, and start looking around the area.{w}\nDamek was right, everything seems to be going so well.{w}\nWe deserve it, after what we went through. That's what I think."
    "他们四散开来，开始在周围打量。{w}\n达梅克说得对，一切看起来都顺利极了。{w}\n经历了那些之后，这是我们应得的。我是这么想的。"

# game/script.rpy:127179
translate chinese map184_607fc6b8:

    # "It's crazy to think that within a few days we'd be attacking Balteus.{w}\nWe couldn't waste any time. We'd go right after securing this alliance.{w}\nBut I think back to the moment on the ship, where I touched the blade."
    "一想到几天之内我们就要进攻巴尔泰乌斯，实在疯狂。{w}\n我们一刻也不能浪费。一敲定结盟，我们就立刻出发。{w}\n但我又回想起在船上的那一刻，我触碰那把剑的时候。"

# game/script.rpy:127181
translate chinese map184_9d6bedb6:

    # "I wanted it to show me our victory, and it showed me nothing.{w}\nPushing forward, in spite of that? That was the definition of hope.{w}\nIf there was anything that would help us win this war, it was that hope."
    "我想让它向我展示我们的胜利，它却什么都没显示。{w}\n即便如此仍要继续前行？那正是希望的定义。{w}\n如果说有什么能帮我们打赢这场战争，那就是那份希望。"

# game/script.rpy:127480
translate chinese click_map185_4_EV004_6fb191ea:

    # "How did they get these trees to live in this weather...?{w}\nThey look like trees back in the mainland. They don't belong here.{w}\nIt must require a tremendous amount of care to ensure they stay alive."
    "他们是怎么让这些树在这种天气里存活的……？{w}\n它们看起来像大陆那边的树。它们本不属于这里。{w}\n要让它们活下来，肯定得投入极大的心血。"

# game/script.rpy:127482
translate chinese click_map185_4_EV004_b3cb9b49:

    # "If anything, it serves to make me feel less homesick.{w}\nA part of the mainland is right here with me and my comrades.{w}\nThat puts me at ease, so I choose not to question this further."
    "真要说的话，这反倒让我不那么想家了。{w}\n大陆的一角，就这样陪在我和同伴们身边。{w}\n这让我安心，所以我选择不再深究。"

# game/script.rpy:127519
translate chinese click_map185_5_EV005_a99e994c:

    # voice "se/a00318.ogg"
    voice "se/a00318.ogg"

# game/script.rpy:127521
translate chinese click_map185_5_EV005_d6eaba04:

    # char_valessa "What's this place for...?"
    char_valessa "这地方是做什么用的……？"

# game/script.rpy:127524
translate chinese click_map185_5_EV005_aec04903:

    # voice "se/a00319.ogg"
    # char_ulric "Security, normally.\nBut there isn't any during the ball.\nAnybody is just free to walk inside."
    voice "se/a00319.ogg"
    char_ulric "平时是有守卫的。\n但舞会期间这里没有守卫。\n任何人都可以随便走进去。"

# game/script.rpy:127528
translate chinese click_map185_5_EV005_9234f21c:

    # voice "se/a00320.ogg"
    # char_valessa "Oh, okay. Is security normally heavy?"
    voice "se/a00320.ogg"
    char_valessa "哦，这样。平时守卫很严吗？"

# game/script.rpy:127532
translate chinese click_map185_5_EV005_e5078c89:

    # voice "se/a00321.ogg"
    # char_ulric "Yeah, they need to fend off assassins.\nAs a ruler here, you're constantly a target.\nI can't imagine living in that constant fear."
    voice "se/a00321.ogg"
    char_ulric "是啊，他们得防刺客。\n在这里当统治者，你就是个永远的目标。\n我无法想象活在那种持续的恐惧中。"

# game/script.rpy:127536
translate chinese click_map185_5_EV005_ffed597e:

    # voice "se/a00322.ogg"
    # char_valessa "Wait, what happens if a leader is assassinated?\nDoes the killer become the new ruler of Alarinthia?"
    voice "se/a00322.ogg"
    char_valessa "等等，要是领袖被暗杀了会怎样？\n凶手会成为阿拉林西亚的新统治者吗？"

# game/script.rpy:127540
translate chinese click_map185_5_EV005_4db34116:

    # voice "se/a00323.ogg"
    # char_ulric "No. The killer is usually given the death penalty.\nThen, an open tournament is held to find the strongest man.\nIt's considered cowardly to kill someone when they aren't prepared."
    voice "se/a00323.ogg"
    char_ulric "不会。凶手通常会被判处死刑。\n然后举行一场公开的锦标赛，选出最强的人。\n趁人毫无防备时下手，会被视为懦夫行径。"

# game/script.rpy:127544
translate chinese click_map185_5_EV005_7d1f639a:

    # voice "se/a00324.ogg"
    # char_valessa "Oh, I guess that makes sense. I was kind of wondering.\nI mean, Vivien could just easily assassinate Draycu, right?\nBut now it makes sense why they didn't go that route."
    voice "se/a00324.ogg"
    char_valessa "哦，这倒说得通。我本来还有点纳闷。\n我是说，薇薇安完全可以轻易暗杀德雷库，对吧？\n但现在我明白他们为什么没走那条路了。"

# game/script.rpy:127548
translate chinese click_map185_5_EV005_e0c62fd5:

    # voice "se/a00325.ogg"
    # char_ulric "Yeah, it would change nothing. Vivien would still need to fight.\nHe'd stand no chance in an open tournament like that.\nA coliseum battle is the only way for him to do this."
    voice "se/a00325.ogg"
    char_ulric "是啊，那也改变不了什么。薇薇安还是得打一场。\n在那种公开锦标赛里，他毫无胜算。\n竞技场决斗才是他唯一的办法。"

# game/script.rpy:127552
translate chinese click_map185_5_EV005_f43d3b98:

    # voice "se/a00325b.ogg"
    # char_valessa "Would people respect the change if Vivien won...?\nOr would they want to fight him in the coliseum, too?"
    voice "se/a00325b.ogg"
    char_valessa "如果薇薇安赢了，人们会尊重这种改变吗……？\n还是说，他们也想在竞技场上和他打一场？"

# game/script.rpy:127556
translate chinese click_map185_5_EV005_4fbd7531:

    # voice "se/a00326.ogg"
    # char_ulric "They'd probably want to fight him, for a while.\nBut a ruler can always turn down a challenge.\nUsually, they're arrogant, so they don't do that."
    voice "se/a00326.ogg"
    char_ulric "他们大概会想和他打，持续一阵子。\n但统治者随时可以拒绝挑战。\n通常他们都傲慢得很，所以不会拒绝。"

# game/script.rpy:127560
translate chinese click_map185_5_EV005_5cfe68e1:

    # voice "se/a00327.ogg"
    # char_ulric "And it's not a change they need to respect.\nNo matter what, Vivien is still in charge.\nHe'd likely merge with The New Monarchy."
    voice "se/a00327.ogg"
    char_ulric "而且这种改变也不需要他们认可。\n无论如何，掌权的还是薇薇安。\n他很可能会与新王权合并。"

# game/script.rpy:127564
translate chinese click_map185_5_EV005_a98c28ac:

    # voice "se/a00328.ogg"
    # char_ulric "And at that point, there's nothing they can do.\nHistory is already made, treaties already signed.\nThat is, if [firstname] decides to side with Vivien."
    voice "se/a00328.ogg"
    char_ulric "到那时候，他们就无能为力了。\n历史已成定局，条约也已签署。\n前提是，[firstname]决定站在薇薇安这边。"

# game/script.rpy:127568
translate chinese click_map185_5_EV005_ab1ef24a:

    # voice "se/a00329.ogg"
    # char_valessa "It seems like an easy choice, doesn't it?"
    voice "se/a00329.ogg"
    char_valessa "这选择看起来很简单，不是吗？"

# game/script.rpy:127572
translate chinese click_map185_5_EV005_5d22e9d3:

    # voice "se/a00330.ogg"
    # char_ulric "I guess we'll see."
    voice "se/a00330.ogg"
    char_ulric "我想，走着瞧吧。"

# game/script.rpy:127610
translate chinese click_map185_6_EV006_f3ca5de6:

    # "The gates don't seem to lead directly to the castle.{w}\nThere still seems to be a long way to walk once you enter them.{w}\nI can see the entrance to the actual castle far down a paved road."
    "大门似乎并不直通城堡。{w}\n进去之后，好像还有很长一段路要走。{w}\n我能看到真正城堡的入口，在石板路的尽头。"

# game/script.rpy:127612
translate chinese click_map185_6_EV006_a177cf37:

    # "It almost seems like an experience to approach the castle.{w}\nIt's a little gaudy, but I guess we just have different tastes.{w}\nI wonder why there are some people partying out here."
    "走向城堡的过程，简直就像一场体验。{w}\n有点俗气，但大概只是我们品味不同。{w}\n我很好奇，为什么有些人在这外面聚会。"

# game/script.rpy:127614
translate chinese click_map185_6_EV006_a91ad04e:

    # "Are they full inside or something...?{w}\nOr maybe they just wanted to get away from the noise.{w}\nEither way, this indicated there was a ton of people at the ball."
    "是里面满了吗……？{w}\n还是说，他们只是想避开喧闹。{w}\n不管怎样，这说明舞会上人多得不得了。"

# game/script.rpy:127651
translate chinese click_map185_7_EV007_0a2c1d23:

    # "The castle is massive, I've never seen anything like it.{w}\nI wonder if The Triumvirate's castle will be anything like this.{w}\nIt's crazy to think that each ruler adds more and more onto it."
    "这座城堡巨大无比，我从没见过这样的建筑。{w}\n不知道三人执政团的城堡会不会也这样。{w}\n一想到每位统治者都往上加一点，就觉得离谱。"

# game/script.rpy:127653
translate chinese click_map185_7_EV007_f8aa04d4:

    # "That gives it something like a \"patchwork\" look.{w}\nEvery ruler had a different taste in design, after all.{w}\nI can't even imagine the story behind this castle."
    "这让它看起来像是一块“拼布”。{w}\n毕竟，每位统治者的设计品味都不同。{w}\n这座城堡背后的故事，我根本无法想象。"

# game/script.rpy:127656
translate chinese click_map185_7_EV007_036a5098:

    # voice "se/a00310.ogg"
    # char_fortaime "Now that's something I'd like to climb.\nUlric, what do you think about that?"
    voice "se/a00310.ogg"
    char_fortaime "这才是我想要攀爬的东西。\n乌尔里克，你觉得怎么样？"

# game/script.rpy:127660
translate chinese click_map185_7_EV007_167bf4f2:

    # voice "se/a00311.ogg"
    # char_ulric "I'd rather you didn't.\nThey might think you're breaking in.\nOr even worse, coming to kill Draycu."
    voice "se/a00311.ogg"
    char_ulric "我宁愿你别去。\n他们可能会以为你在闯入。\n或者更糟，以为你是来杀德雷库的。"

# game/script.rpy:127664
translate chinese click_map185_7_EV007_e0c3ee8d:

    # voice "se/a00312.ogg"
    # char_fortaime "Oh. Maybe I'll ask him first, then.\nDo you think he'd give me permission?"
    voice "se/a00312.ogg"
    char_fortaime "哦。那也许我该先问问他。\n你觉得他会准许我吗？"

# game/script.rpy:127668
translate chinese click_map185_7_EV007_08d51e75:

    # voice "se/a00313.ogg"
    # char_ulric "I don't think he's the \"giving\" type, Fortaime.\nHe'd probably just laugh you away, and call you a fool."
    voice "se/a00313.ogg"
    char_ulric "我觉得他不是那种会“准许”的人，福泰姆。\n他大概只会嘲笑你，说你是傻瓜。"

# game/script.rpy:127672
translate chinese click_map185_7_EV007_5cc53ace:

    # voice "se/a00314.ogg"
    # char_fortaime "Wait, really? Then what about this ball...?\nIsn't he just giving all of this stuff away?"
    voice "se/a00314.ogg"
    char_fortaime "等等，真的吗？那这场舞会又是怎么回事……？\n他不就是把这些东西全都白白送人吗？"

# game/script.rpy:127676
translate chinese click_map185_7_EV007_d3085e80:

    # voice "se/a00315.ogg"
    # char_ulric "Well yeah, but not for free.\nIt's to win the people over, gain their allegiance.\nHe's not doing it to be generous. He has a motive."
    voice "se/a00315.ogg"
    char_ulric "是啊，但不是免费的。\n这是为了收买人心，赢得他们的效忠。\n他这么做不是出于慷慨。他有自己的目的。"

# game/script.rpy:127680
translate chinese click_map185_7_EV007_df2d3490:

    # voice "se/a00316.ogg"
    # char_fortaime "True... I'll still give it a shot, though.\nThe worst he can do is say no."
    voice "se/a00316.ogg"
    char_fortaime "也对……不过我还是想试一试。\n他大不了就是拒绝。"

# game/script.rpy:127684
translate chinese click_map185_7_EV007_e5893198:

    # voice "se/a00317.ogg"
    # char_ulric "Trust me, he can do far worse than that.\nDon't ask unless you're ready to handle it."
    voice "se/a00317.ogg"
    char_ulric "相信我，他能做的远不止拒绝。\n除非你准备好承受后果，不然别开口。"

# game/script.rpy:127749
translate chinese map189_95ebb257:

    # "The throne room is crowded, and full of people partying.{w}\nNormally, I imagine this would be reserved for Draycu alone.{w}\nBut right now, open to everybody, it's almost like a big ballroom."
    "王座厅里挤满了人，全是参加宴会的。{w}\n我想，平时这里应该只有德雷库一个人用。{w}\n但现在，它对所有人开放，几乎就像一间大舞厅。"

# game/script.rpy:127751
translate chinese map189_a0ac41a1:

    # "A man sits on the throne, watching the people as if it entertains him.{w}\nThat must be Draycu. I scan the room, and I notice Vivien in a corner.{w}\nSince no one knows what he looks like, he must blend in perfectly."
    "一个男人坐在王座上，看着人群，仿佛以此为乐。{w}\n那一定就是德雷库。我扫视整个房间，注意到角落里的薇薇安。{w}\n既然没人知道他的长相，他一定混得天衣无缝。"

# game/script.rpy:127753
translate chinese map189_0d73e99a:

    # "He must've snuck ahead of us while we were talking back at the gates.{w}\nI guess all the pieces were in place. This ball was about to get interesting.{w}\nI wonder how many people here were part of Vivien's insurrection."
    "我们在大门口说话时，他一定悄悄先溜了进来。{w}\n我想，所有棋子都已就位。这场舞会就要变得精彩了。{w}\n不知道这里有几个人是薇薇安起义的一份子。"

# game/script.rpy:127755
translate chinese map189_d42625cc:

    # "Westy stands beside Draycu, and I see them whisper to one another.{w}\nA few moments later, Draycu stands up, eyeing down me and my comrades.{w}\nI didn't notice how tall and imposing he was until he stood up. Almost a match for Ulric."
    "韦斯蒂站在德雷库身旁，我看到他们互相低语。{w}\n片刻之后，德雷库站起身，居高临下地打量我和我的同伴。{w}\n直到他站起来，我才注意到他有多高大、多有威势。几乎能跟乌尔里克一较高下。"

# game/script.rpy:127780
translate chinese map189_7192b8ba:

    # voice "se/z01816.ogg"
    voice "se/z01816.ogg"

# game/script.rpy:127786
translate chinese map189_4331b92d:

    # char_jit_map189_1_0_25 "Silence."
    char_jit_map189_1_0_25 "安静。"

# game/script.rpy:127800
translate chinese map189_a81a2881:

    # "His deep voice echoes through the entire throne room, and everybody stops talking.{w}\nThey turn to him, as if out of fear, and await his next words. But I know what they'll be.{w}\nHe knows who we are — and with Vivien here, it's likely that he's ready to make a move."
    "他低沉的嗓音在整个王座厅里回荡，所有人都停止了交谈。{w}\n他们仿佛出于恐惧般转向他，等待他接下来的话。但我知道那会是什么。{w}\n他知道我们是谁——而薇薇安也在这里，他多半已经准备好出手了。"

# game/script.rpy:127825
translate chinese map189_059d5534:

    # voice "se/z01817.ogg"
    # char_jit_map189_1_0_25 "We have those who would disturb the peace among us.\nGuards, lock the doors. We have some business to take care of."
    voice "se/z01817.ogg"
    char_jit_map189_1_0_25 "我们当中，有人意图扰乱安宁。\n卫兵，把门锁上。我们有些事要处理。"

# game/script.rpy:127840
translate chinese map189_b0ed129b:

    # "He claps his hands once, in a commanding gesture.{w}\nSoon after, a group of people close the throne room doors.{w}\nThey carry no weapons, and are disguised as partygoers."
    "他威严地拍了一下手。{w}\n很快，一群人关上了王座厅的大门。{w}\n他们没带武器，伪装成参加宴会的人。"

# game/script.rpy:127865
translate chinese map189_5b700b29:

    # voice "se/z01818.ogg"
    # char_jit_map189_1_0_25 "Now how should we deal with those who disturb the peace...?\nWatching them starve in the cells doesn't do much for me anymore."
    voice "se/z01818.ogg"
    char_jit_map189_1_0_25 "那么，扰乱安宁的人该怎么处置……？\n看着他们在牢里饿死，对我来说已经没什么意思了。"

# game/script.rpy:127880
translate chinese map189_43b922ac:

    # "The crowd starts shouting out a bunch of potential punishments.{w}\nDraycu laughs, clearly enjoying all of the horrible ideas thrown his way."
    "人群开始大声嚷嚷着各种可能的惩罚。{w}\n德雷库大笑起来，显然很享受这些抛向他的可怕点子。"

# game/script.rpy:127905
translate chinese map189_ecda392f:

    # voice "se/z01819.ogg"
    # char_jit_map189_1_0_25 "I say we hear them out, and treat them in kind.\nSo tell us, why did you come here today...?"
    voice "se/z01819.ogg"
    char_jit_map189_1_0_25 "依我看，我们先听听他们要说什么，再以彼之道还施彼身。\n那么告诉我们，你们今天为什么来这里……？"

# game/script.rpy:127920
translate chinese map189_1aadb1ec:

    # "I take a step forward in response, but then Draycu looks the other way.{w}\nFixing his view to the corner of the room, I realize he wasn't talking to me."
    "我上前一步作为回应，可德雷库却望向了别处。{w}\n他把目光定在房间的角落，我这才意识到，他不是在跟我说话。"

# game/script.rpy:127945
translate chinese map189_0d25e41c:

    # voice "se/z01820.ogg"
    # char_jit_map189_1_0_25 "Vivien."
    voice "se/z01820.ogg"
    char_jit_map189_1_0_25 "薇薇安。"

# game/script.rpy:127960
translate chinese map189_72719017:

    # "Everybody looks toward the corner, and Vivien scoffs.{w}\nMoving forward, he stands in the center of the room."
    "所有人都望向那个角落，薇薇安嗤笑一声。{w}\n他走上前，站到了房间中央。"

# game/script.rpy:127982
translate chinese map189_834ac42a:

    # voice "se/z01821.ogg"
    voice "se/z01821.ogg"

# game/script.rpy:127988
translate chinese map189_a6a03e9c:

    # char_jit_map189_1_0_135 "Draycu."
    char_jit_map189_1_0_135 "德雷库。"

# game/script.rpy:128013
translate chinese map189_70fe9a5d:

    # voice "se/z01822.ogg"
    # char_jit_map189_1_0_25 "You come here on my day of celebration to challenge me.\nIt is an insult to both me and all of these proud Alarinthians.\nLooking deep into our core, you say we're not good enough."
    voice "se/z01822.ogg"
    char_jit_map189_1_0_25 "你在我庆祝的日子里来向我挑战。\n这是对我、以及对所有这些骄傲的阿拉林西亚人的侮辱。\n你直指我们的根本，说我们不够好。"

# game/script.rpy:128017
translate chinese map189_41bf5c47:

    # voice "se/z01823.ogg"
    # char_jit_map189_1_0_25 "We honor the traditions of the Ancients, as we should.\nWithout them, we wouldn't be here today. You want to tear us apart.\nYou want to create a nation that's weak, just like the mainland."
    voice "se/z01823.ogg"
    char_jit_map189_1_0_25 "我们尊崇先古的传统，理应如此。\n没有它们，就没有今天的我们。而你想把我们撕裂。\n你想建立一个软弱的国度，就像大陆一样。"

# game/script.rpy:128043
translate chinese map189_ead05ff2:

    # voice "se/z01824.ogg"
    # char_jit_map189_1_0_135 "No, you've got it all wrong. Lack of strength is {i}not{/i} a weakness.\nThe unity of the mainland, their shared ideals — that's true strength!\nYou stand here, alone, victim to your incessant squabbling!"
    voice "se/z01824.ogg"
    char_jit_map189_1_0_135 "不，你完全搞错了。缺乏武力{i}并不{/i}软弱。\n大陆的团结、他们共同的理想——那才是真正的强大！\n而你独自站在这里，沦为无休止内斗的牺牲品！"

# game/script.rpy:128058
translate chinese map189_cb1eb9d7:

    # "Vivien takes a few steps toward the throne, with intense passion.{w}\nI can tell that this is something he'd really fight with his life for."
    "薇薇安满怀炽热的激情，朝王座走了几步。{w}\n我看得出，这是他会拼上性命去争取的东西。"

# game/script.rpy:128083
translate chinese map189_19685df4:

    # voice "se/z01825.ogg"
    # char_jit_map189_1_0_25 "We yield to no one, while they are docile slaves of The Triumvirate.\nThey crush the mainlanders under their heel, who ask no questions at all.\nAlarinthia is a free land. We make our own choices, and {i}we{/i} hold the power."
    voice "se/z01825.ogg"
    char_jit_map189_1_0_25 "我们不向任何人低头，而他们只是三人执政团温顺的奴隶。\n他们任由三人执政团把大陆人踩在脚下，一个疑问都不敢提。\n阿拉林西亚是自由之地。我们自己做选择，而权力握在{i}我们{/i}手里。"

# game/script.rpy:128108
translate chinese map189_a07a5732:

    # "Pro pushes me aside and steps forward, standing beside Vivien.{w}\nUlric reaches out to stop him, but he's not quick enough."
    "普洛把我推到一旁，走上前去，站到薇薇安身边。{w}\n乌尔里克伸手想拦住他，却没来得及。"

# game/script.rpy:128136
translate chinese map189_8823131e:

    # voice "se/z01826.ogg"
    voice "se/z01826.ogg"

# game/script.rpy:128139
translate chinese map189_a08d33d0:

    # char_pro "Then help us gain our freedom!"
    char_pro "那就帮我们争取自由！"

# game/script.rpy:128153
translate chinese map189_d3f956dd:

    # "All eyes are diverted our way, and even Vivien seems surprised."
    "所有人的目光都转向我们这边，就连薇薇安似乎也很意外。"

# game/script.rpy:128178
translate chinese map189_ba0ac649:

    # voice "se/z01827.ogg"
    # char_jit_map189_1_0_25 "Hmm...?"
    voice "se/z01827.ogg"
    char_jit_map189_1_0_25 "嗯……？"

# game/script.rpy:128204
translate chinese map189_2e3094ef:

    # voice "se/z01828.ogg"
    # char_pro "We've come here seeking an alliance.\nWe're not all mindless slaves, you know!"
    voice "se/z01828.ogg"
    char_pro "我们是来这里寻求结盟的。\n你知道的，我们可不都是没有头脑的奴隶！"

# game/script.rpy:128230
translate chinese map189_edab6da3:

    # voice "se/z01828b.ogg"
    # char_jit_map189_1_0_25 "An alliance...? And what can you offer me?\nYou look as if I could crush you with one hand."
    voice "se/z01828b.ogg"
    char_jit_map189_1_0_25 "结盟……？那你能给我什么？\n你看起来，我一只手就能把你捏碎。"

# game/script.rpy:128256
translate chinese map189_3e16283f:

    # voice "se/z01829.ogg"
    # char_pro "I'm stronger than you think. We all are!\nWe grew up alone, on the streets of Mazeo.\nIf we weren't strong, we'd be long dead by now."
    voice "se/z01829.ogg"
    char_pro "我比你想象的更强。我们都是！\n我们独自在马泽奥的街头长大。\n要是我们不够强，早就死透了。"

# game/script.rpy:128282
translate chinese map189_e6533be0:

    # voice "se/z01830.ogg"
    # char_jit_map189_1_0_25 "You? On the streets of Mazeo?\nMy apologies, that is quite respectable.\nYou must be part of The Monarch's crew?"
    voice "se/z01830.ogg"
    char_jit_map189_1_0_25 "你？在马泽奥的街头？\n我道歉，那相当令人敬佩。\n你一定就是君主的手下？"

# game/script.rpy:128298
translate chinese map189_bae22b2f:

    # voice "se/z01831.ogg"
    # char_pro "Yes, and we've come to seek your aid.\nYou keep talking about how strong you are...?\nThen help us take down those who claim Godhood!"
    voice "se/z01831.ogg"
    char_pro "没错，我们是来寻求你的援助的。\n你一直在说自己有多强……？\n那就帮我们扳倒那些自称神明的人！"

# game/script.rpy:128313
translate chinese map189_c5e680dd:

    # "Everyone watches in awe, as this turns into a standoff."
    "所有人都敬畏地看着，气氛变成了对峙。"

# game/script.rpy:128338
translate chinese map189_be9b4e59:

    # voice "se/z01832.ogg"
    # char_jit_map189_1_0_25 "And what do I get in return...?"
    voice "se/z01832.ogg"
    char_jit_map189_1_0_25 "那我能得到什么回报……？"

# game/script.rpy:128353
translate chinese map189_17b6fa83:

    # "Pro steps forward, confidence radiating from the way he moves."
    "普洛走上前，举手投足间散发着自信。"

# game/script.rpy:128378
translate chinese map189_bf754e10:

    # voice "se/z01833.ogg"
    # char_pro "I will be your Champion, and offer some of our forces.\nTogether, we can {i}crush{/i} Vivien's pathetic insurrection.\nAllow us this chance to prove our strength as worthy allies!"
    voice "se/z01833.ogg"
    char_pro "我来当你的斗士，并献上我们的一部分兵力。\n我们联手，就能{i}碾碎{/i}薇薇安那可悲的起义。\n请给我们这个机会，证明我们作为盟友的价值！"

# game/script.rpy:128393
translate chinese map189_2ded31c3:

    # "He kneels down, offering his loyalty to Draycu.{w}\nWhat was he doing...!? He's playing right into Draycu's hand!{w}\nWesty told us that Draycu needed our army. He's only {i}playing{/i} dumb!"
    "他跪下，向德雷库献上忠诚。{w}\n他在干什么……！？这正是德雷库想要的！{w}\n韦斯蒂告诉过我们，德雷库需要我们的军队。他只是在{i}装{/i}傻！"

# game/script.rpy:128395
translate chinese map189_aca94e10:

    # "Draycu steps down the stairs leading to his throne.{w}\nHe stays far from Vivien and Pro, but they're now level."
    "德雷库走下通往王座的台阶。{w}\n他与薇薇安和普洛保持着距离，但他们现在处于同一高度了。"

# game/script.rpy:128420
translate chinese map189_901be5f9:

    # voice "se/z01834.ogg"
    # char_jit_map189_1_0_25 "What an unconventional turn of events.\nVivien, you were seeking a challenge, yes?"
    voice "se/z01834.ogg"
    char_jit_map189_1_0_25 "多么不合常规的转折。\n薇薇安，你是在寻求一场挑战，对吧？"

# game/script.rpy:128446
translate chinese map189_417dae04:

    # voice "se/z01835.ogg"
    # char_jit_map189_1_0_135 "Yes, at the break of dawn.\nI will allow you your final night of revelry."
    voice "se/z01835.ogg"
    char_jit_map189_1_0_135 "是的，就在破晓时分。\n我会允许你享受最后一个狂欢之夜。"

# game/script.rpy:128472
translate chinese map189_44f5fd1e:

    # voice "se/z01836.ogg"
    # char_jit_map189_1_0_25 "And who will fight as your Champion?"
    voice "se/z01836.ogg"
    char_jit_map189_1_0_25 "那谁来当你的斗士出战？"

# game/script.rpy:128488
translate chinese map189_f00567fb:

    # voice "se/z01837.ogg"
    # char_jit_map189_1_0_135 "Ulric."
    voice "se/z01837.ogg"
    char_jit_map189_1_0_135 "乌尔里克。"

# game/script.rpy:128503
translate chinese map189_23f36dd1:

    # "He motions back toward Ulric, who steps forward.{w}\nStanding beside Vivien, his loyalty and stance is clear."
    "他朝身后的乌尔里克一示意，乌尔里克便走上前。{w}\n他站在薇薇安身旁，忠诚与立场昭然若揭。"

# game/script.rpy:128518
translate chinese map189_b2b98843:

    # voice "se/z01838.ogg"
    # char_jit_map189_1_0_25 "I see."
    voice "se/z01838.ogg"
    char_jit_map189_1_0_25 "我明白了。"

# game/script.rpy:128533
translate chinese map189_9013557e:

    # "Draycu eyes Pro up and down."
    "德雷库上下打量着普洛。"

# game/script.rpy:128558
translate chinese map189_7a88d575:

    # voice "se/z01839.ogg"
    # char_jit_map189_1_0_25 "And what do they call {i}you{/i}...?"
    voice "se/z01839.ogg"
    char_jit_map189_1_0_25 "那{i}你{/i}叫什么名字……？"

# game/script.rpy:128584
translate chinese map189_4bff3829:

    # voice "se/z01840.ogg"
    # char_pro "They call me Pro, your excellence.\nIt would be my honor to fight with you in the coliseum.\nI offer my life, and the life of our forces to your cause."
    voice "se/z01840.ogg"
    char_pro "他们叫我普洛，大人。\n能与您在竞技场并肩作战，是我的荣幸。\n我愿为您的事业献上我的生命，以及我们军队的性命。"

# game/script.rpy:128599
translate chinese map189_178afbcc:

    # "I step forward, ready to object to these events, but Draycu speaks first."
    "我上前一步，准备对这一切提出异议，可德雷库先开了口。"

# game/script.rpy:128624
translate chinese map189_b3bc5639:

    # voice "se/z01841.ogg"
    # char_jit_map189_1_0_25 "I accept your offer, Pro.\nVivien isn't worth using my own men.\nBut — you lack the authority to make this pledge."
    voice "se/z01841.ogg"
    char_jit_map189_1_0_25 "我接受你的提议，普洛。\n薇薇安不值得我动用自己的人。\n但是——你无权做出这个承诺。"

# game/script.rpy:128639
translate chinese map189_6614ec1e:

    # "He looks straight at me, eyeing the blade on my back."
    "他直直看着我，目光落在我背上的剑上。"

# game/script.rpy:128664
translate chinese map189_e15a5858:

    # voice "se/z01842.ogg"
    # char_jit_map189_1_0_25 "That decision lies with [firstname].\nHelp me defeat Vivien, and I will offer you my might.\nGo against me, and I cannot guarantee your survival."
    voice "se/z01842.ogg"
    char_jit_map189_1_0_25 "这个决定取决于[firstname]。\n帮我击败薇薇安，我就会献上我的力量。\n与我为敌，我就无法保证你们能活下来。"

# game/script.rpy:128691
translate chinese map189_11d19005:

    # "This is all happening so fast, but I know that's Draycu's plan.{w}\nHe wants us to fight his battle for him. I don't even know if he's trustworthy.{w}\nBut Pro, in his haste, put me in an almost impossible position to manage."
    "这一切发生得太快，但我知道这正是德雷库的算计。{w}\n他想让我们替他打这场仗。我甚至不知道他是否值得信任。{w}\n可普洛这么一冲动，把我逼进了一个几乎无法应对的境地。"

# game/script.rpy:128693
translate chinese map189_7be996bf:

    # "If I sided with Vivien and Ulric, we'd have to fight Pro and Draycu.{w}\nDraycu would have our forces as backup, while Vivien would have his.{w}\nThis was a fight to the death, so major losses seemed unavoidable."
    "如果我站到薇薇安和乌尔里克那边，我们就得与普洛和德雷库为敌。{w}\n德雷库会有我们的军队作后援，而薇薇安有他自己的。{w}\n这是生死决斗，所以重大伤亡似乎无法避免。"

# game/script.rpy:128695
translate chinese map189_5bc22abd:

    # "This battle would likely happen regardless of my support.{w}\nSo not picking a side would only harm our cause in the long run.{w}\nBut choosing Pro over Ulric, or vice versa, could hurt our bond."
    "这场战斗无论我支不支持，多半都会发生。{w}\n所以不选边站，长远来看只会损害我们的事业。{w}\n可选普洛不选乌尔里克，或者反过来，又可能伤害我们的情谊。"

# game/script.rpy:128697
translate chinese map189_47603d46:

    # "I close my eyes, and clench my fists together.{w}\nI needed to stop thinking about this so personally.{w}\nPeople would die either way. This is war. It's unavoidable."
    "我闭上眼，攥紧拳头。{w}\n我不能再把这事看得这么私人了。{w}\n无论怎样都会有人死。这是战争。无法避免。"

# game/script.rpy:128699
translate chinese map189_6277ada6:

    # "So the real question is — what kind of future do I want for Alarinthia...?{w}\nDo I want Draycu to remain in power, and for things to remain unchanged?{w}\nOr do I want Vivien to overthrow the nation, and ally Alarinthia with the mainland?"
    "所以真正的问题是——我想要阿拉林西亚有什么样的未来……？{w}\n我想让德雷库继续掌权，让一切维持原样吗？{w}\n还是想让薇薇安推翻这个国家，让阿拉林西亚与大陆结盟？"

# game/script.rpy:128701
translate chinese map189_9c6186b7:

    # "No, I need to detatch myself even further..."
    "不，我需要把自己抽离得更远……"

# game/script.rpy:128703
translate chinese map189_0802b4d4:

    # "No Pro... No Ulric...{w}\nNo Draycu... No Vivien...{w}\nJust Alarinthia — that's all."
    "没有普洛……没有乌尔里克……{w}\n没有德雷库……没有薇薇安……{w}\n只有阿拉林西亚——仅此而已。"

# game/script.rpy:128733
translate chinese map189_e441faf9:

    # voice "se/z01843.ogg"
    voice "se/z01843.ogg"

# game/script.rpy:128735
translate chinese map189_5418ae47:

    # char_jit_map189_1_0_25 "Monarch, what is your decree?\nFight with me, and prove yourselves worthy of my help?\nOr fight with Vivien, against thousands of years of tradition?"
    char_jit_map189_1_0_25 "君主，你的裁决是什么？\n与我并肩作战，证明你们配得上我的帮助？\n还是与薇薇安并肩，对抗数千年的传统？"

# game/script.rpy:128760
translate chinese Choice_map189_1_0_ae62cc58:

    # "I take a deep breath before announcing my choice.{w}\nWe would help Draycu, and prove ourselves as worthy allies.{w}\nWe would defeat The Triumvirate, and keep Alarinthia unchanged."
    "我深吸一口气，然后宣布我的选择。{w}\n我们将帮助德雷库，证明自己是值得结交的盟友。{w}\n我们将击败三人执政团，让阿拉林西亚保持原样。"

# game/script.rpy:128762
translate chinese Choice_map189_1_0_e2674746:

    # "But that meant we'd be fighting against Ulric in the coliseum.{w}\nHe was putting his life on the line to change the nation.{w}\nVivien looks at me, visibly disappointed in my choice."
    "但那意味着我们要在竞技场上与乌尔里克为敌。{w}\n他正为改变这个国家而赌上性命。{w}\n薇薇安看着我，对我的选择明显感到失望。"

# game/script.rpy:128790
translate chinese Choice_map189_1_0_5ac17c7a:

    # voice "se/z01844.ogg"
    # char_jit_map189_1_0_135 "If I win, don't come begging for my help.\nI won't forget this choice, [firstname]. I swear.\nCome on Ulric, let's go prepare. We can do this alone."
    voice "se/z01844.ogg"
    char_jit_map189_1_0_135 "如果我赢了，别来求我帮忙。\n我不会忘记这个选择，[firstname]。我发誓。\n走吧，乌尔里克，我们去准备。我们靠自己也能行。"

# game/script.rpy:128814
translate chinese Choice_map189_1_0_dd328d9a:

    # "I take a deep breath before announcing my choice.{w}\nWe would help Vivien, in exchange for the forces he could offer.{w}\nWe would defeat Draycu, and give this nation a new and bright future."
    "我深吸一口气，然后宣布我的选择。{w}\n我们将帮助薇薇安，以换取他能提供的兵力。{w}\n我们将击败德雷库，给这个国家一个崭新光明的未来。"

# game/script.rpy:128816
translate chinese Choice_map189_1_0_0b42bfa5:

    # "But that meant we'd be fighting against Pro in the coliseum.{w}\nHe so foolishly pledged his support, I had no idea how to react.{w}\nI never expected insubordination, and borderline betrayal from this."
    "但那意味着我们要在竞技场上与普洛为敌。{w}\n他那么愚蠢地宣誓效忠，我完全不知该如何反应。{w}\n我从没想过会发生这种事——抗命，甚至近乎背叛。"

# game/script.rpy:128844
translate chinese Choice_map189_1_0_c43aeb14:

    # voice "se/z01845.ogg"
    # char_pro "Our lives were on the line, I had to make the right choice.\nI'd rather live with Draycu than sacrifice myself for Vivien.\nUlric has the wrong idea. What he's doing is suicide!"
    voice "se/z01845.ogg"
    char_pro "我们的命都悬在一线，我必须做正确的选择。\n我宁愿与德雷库共存，也不愿为薇薇安牺牲自己。\n乌尔里克想错了。他这是在自杀！"

# game/script.rpy:128872
translate chinese Choice_map189_1_0_88a72fcb:

    # voice "se/z01848.ogg"
    voice "se/z01848.ogg"

# game/script.rpy:128875
translate chinese Choice_map189_1_0_7d352d80:

    # char_howl "Siding with Draycu is the most sound decision.\nHis victory is almost guaranteed, and he has a large army.\nRemember that no one has managed to beat him in the coliseum."
    char_howl "站在德雷库这边是最稳妥的决定。\n他的胜利几乎板上钉钉，而且他还有一支庞大的军队。\n记住，还没人能在竞技场上打败过他。"

# game/script.rpy:128888
translate chinese Choice_map189_1_0_f57d2551:

    # voice "se/z01849.ogg"
    # char_howl "What chance do Vivien and Ulric have...?\nWe fear that this may be the end for those two.\nThis is essentially a choice between life and death."
    voice "se/z01849.ogg"
    char_howl "薇薇安和乌尔里克能有多少胜算……？\n我们担心，这也许就是他们两人的终点了。\n这本质上是一个生与死的选择。"

# game/script.rpy:128902
translate chinese Choice_map189_1_0_a3790386:

    # voice "se/z01850.ogg"
    # char_howl "We do not believe that Vivien can defeat Draycu.\nLet Alarinthia stay the same, [firstname]. It's the right choice.\nDraycu's power will be essential in the coming attack on Balteus."
    voice "se/z01850.ogg"
    char_howl "我们不相信薇薇安能打败德雷库。\n让阿拉林西亚维持原样吧，[firstname]。这是正确的选择。\n在即将到来的巴尔泰乌斯之战中，德雷库的力量至关重要。"

# game/script.rpy:128948
translate chinese Choice_map189_1_0_12a87597:

    # voice "se/z01851.ogg"
    voice "se/z01851.ogg"

# game/script.rpy:128950
translate chinese Choice_map189_1_0_fc6b9882:

    # char_damek "Well our main goal is changing the world, right...?\nWe want a better future for everybody. Not just us.\nIt stands to reason that we should change Alarinthia."
    char_damek "我们的主要目标不就是改变世界吗……？\n我们想要所有人都有更好的未来。不只是我们自己。\n按理说，我们也该改变阿拉林西亚。"

# game/script.rpy:128963
translate chinese Choice_map189_1_0_585fd183:

    # voice "se/z01852.ogg"
    # char_damek "But Vivien can't offer as much power as Draycu can.\nAnd for that matter, I don't want Pro {i}or{/i} Ulric to die.\nThis is all so complicated, I'm not sure what to do."
    voice "se/z01852.ogg"
    char_damek "但薇薇安提供不了德雷库那么多的力量。\n而且说到这个，我既不想让普洛死，{i}也{/i}不想让乌尔里克死。\n这一切太复杂了，我不知道该怎么办。"

# game/script.rpy:128967
translate chinese Choice_map189_1_0_39a8ed9e:

    # voice "se/z01853.ogg"
    # char_damek "Our final attack will be harder if we use Vivien's forces.\nThat is, if Vivien and Ulric can take down Draycu.\nHe's never lost a coliseum battle, remember?"
    voice "se/z01853.ogg"
    char_damek "如果我们用薇薇安的兵力，最后的进攻会更加艰难。\n前提是，薇薇安和乌尔里克能扳倒德雷库。\n记得吗，他从未输过一场竞技场决斗。"

# game/script.rpy:128981
translate chinese Choice_map189_1_0_fd103fd5:

    # voice "se/z01854.ogg"
    # char_damek "I guess it depends on what we want...\nAn easier time during our assault on Balteus.\nOr a changed Alarinthia, at our forces expense."
    voice "se/z01854.ogg"
    char_damek "我想，这取决于我们想要什么……\n攻打巴尔泰乌斯时轻松一些。\n还是以我们的兵力为代价，换来一个改变的阿拉林西亚。"

# game/script.rpy:128995
translate chinese Choice_map189_1_0_eb19655f:

    # voice "se/z01855.ogg"
    # char_damek "There's no wrong choice here, [firstname].\nTake your time, and do what your heart tells you.\nOur end goal, and our purpose, will remain the same."
    voice "se/z01855.ogg"
    char_damek "这里没有错误的选择，[firstname]。\n慢慢来，凭你的心去做。\n我们的最终目标和信念，都不会改变。"

# game/script.rpy:129031
translate chinese Choice_map189_1_0_0167e45e:

    # "Everybody starts to part ways, but the doors remain locked.{w}\nPeople try to open them, but Draycu quickly makes them stop."
    "众人开始各自散去，但大门依然锁着。{w}\n人们试图开门，德雷库却迅速制止了他们。"

# game/script.rpy:129056
translate chinese Choice_map189_1_0_028837ca:

    # voice "se/z01846.ogg"
    # char_jit_map189_1_0_25 "None of you shall leave.\nI wouldn't want you running away."
    voice "se/z01846.ogg"
    char_jit_map189_1_0_25 "你们谁都不准离开。\n我可不希望你们逃跑。"

# game/script.rpy:129071
translate chinese Choice_map189_1_0_23912cae:

    # "He claps his hands and a bunch of servants approach him."
    "他拍了拍手，一群仆人走上前来。"

# game/script.rpy:129096
translate chinese Choice_map189_1_0_2c5cc1e6:

    # voice "se/z01847.ogg"
    # char_jit_map189_1_0_25 "Private quarters will be arranged for those involved in the fight.\nTomorrow morning, you will all be escorted to the coliseum.\nFor tonight, enjoy the ball. I think you'll find it quite exquisite."
    voice "se/z01847.ogg"
    char_jit_map189_1_0_25 "会为参与决斗的人安排私人住处。\n明天早上，你们都会被护送到竞技场。\n今晚，尽情享受舞会吧。我想你们会觉得相当精致。"

# game/script.rpy:129125
translate chinese Choice_map189_1_0_64091c40:

    # "After that, everybody goes back to enjoying the festivities.{w}\nRegardless of our allegiance, we all gather up in the center of the room.{w}\nI never expected that this chain of events would get so complicated."
    "之后，众人又回去享受宴会。{w}\n不管我们各自忠于谁，全都聚到了房间中央。{w}\n我从没想过这一连串事件会变得这么复杂。"

# game/script.rpy:129127
translate chinese Choice_map189_1_0_d8961730:

    # "And Draycu handled it in such a calm manner, too.{w}\nIt's almost as if he was confident in his ability to win.{w}\nUncertainty, confusion, and fright soon fill my mind."
    "而德雷库处理得那么从容。{w}\n就好像他确信自己有取胜的能力。{w}\n不安、困惑与恐惧很快充满了我的心头。"

# game/script.rpy:129129
translate chinese Choice_map189_1_0_12a546fd:

    # "He played us. He provoked Pro into pledging his loyalty.{w}\nAt that point, it was already too late. Pro made up his mind.{w}\nUnknowingly, we all became pawns in the fight for Alarinthia's future."
    "他算计了我们。他激得普洛宣誓效忠。{w}\n到那时，一切已经太迟。普洛下定了决心。{w}\n在不知不觉中，我们都成了争夺阿拉林西亚未来的棋子。"

# game/script.rpy:129131
translate chinese Choice_map189_1_0_567a93b8:

    # "I should probably roam around the ball until it's time to rest.{w}\nI could feel out the situation, and get feedback from my comrades.{w}\nThat would be key to helping me sort out this ongoing mess in my mind."
    "我大概该在舞会上四处走走，直到该休息的时候。{w}\n我可以探探情况，听听同伴们的想法。{w}\n这对理清我脑中这团乱麻至关重要。"

# game/script.rpy:129376
translate chinese click_map190_4_EV004_054c0b7c:

    # voice "se/w00380.ogg"
    voice "se/w00380.ogg"

# game/script.rpy:129378
translate chinese click_map190_4_EV004_7adee284:

    # char_ulric "Pro, what do you think you're doing!?\nI had a plan, and now you've ruined everything!"
    char_ulric "普洛，你以为你在干什么！？\n我本来有计划，现在你把一切都毁了！"

# game/script.rpy:129391
translate chinese click_map190_4_EV004_3bdafe8b:

    # voice "se/w00381.ogg"
    voice "se/w00381.ogg"

# game/script.rpy:129394
translate chinese click_map190_4_EV004_7cee638c:

    # char_pro "Sorry Ulric, it just made sense.\nThis is a fight to the death, right?\nDraycu has {i}never{/i} lost. I had to do it."
    char_pro "抱歉，乌尔里克，但那样做才合理。\n这是生死决斗，对吧？\n德雷库{i}从未{/i}输过。我不得不这么做。"

# game/script.rpy:129407
translate chinese click_map190_4_EV004_ede7c81a:

    # voice "se/w00382.ogg"
    voice "se/w00382.ogg"

# game/script.rpy:129409
translate chinese click_map190_4_EV004_e9218a40:

    # char_ulric "I had everything under control."
    char_ulric "我本来把一切都控制住了。"

# game/script.rpy:129422
translate chinese click_map190_4_EV004_2f6096c5:

    # voice "se/w00383.ogg"
    voice "se/w00383.ogg"

# game/script.rpy:129424
translate chinese click_map190_4_EV004_b5b398d5:

    # char_pro "It's not your job to control everything!\nYou need to get that through your thick skull!"
    char_pro "用不着你什么都管！\n你得把这一点刻进你那顽固的脑子里！"

# game/script.rpy:129437
translate chinese click_map190_4_EV004_89d02326:

    # voice "se/w00384.ogg"
    voice "se/w00384.ogg"

# game/script.rpy:129439
translate chinese click_map190_4_EV004_d3e3c048:

    # char_ulric "You're going to regret this."
    char_ulric "你会后悔的。"

# game/script.rpy:129452
translate chinese click_map190_4_EV004_8cb28ff1:

    # voice "se/w00385.ogg"
    voice "se/w00385.ogg"

# game/script.rpy:129454
translate chinese click_map190_4_EV004_f4f298e8:

    # char_pro "Regret? I can live with that.\nIt's better than dying for nothing.\nDraycu has killed stronger men than you."
    char_pro "后悔？我能承受。\n总比为毫无意义的事送命强。\n德雷库杀过比你更强的人。"

# game/script.rpy:129467
translate chinese click_map190_4_EV004_e603c423:

    # voice "se/w00386.ogg"
    voice "se/w00386.ogg"

# game/script.rpy:129469
translate chinese click_map190_4_EV004_8f6b023c:

    # char_pro "I don't think he's going to lose this battle.\nThat's why I want to be on his good side."
    char_pro "我不觉得这场战斗他会输。\n所以我才想站在他那边。"

# game/script.rpy:129482
translate chinese click_map190_4_EV004_85b493d6:

    # voice "se/w00387.ogg"
    voice "se/w00387.ogg"

# game/script.rpy:129484
translate chinese click_map190_4_EV004_db06335a:

    # char_ulric "So you're just going to suck up to him?\nGet out of my sight, Pro. You're pitiful."
    char_ulric "所以你就打算去巴结他？\n滚出我的视线，普洛。你真可悲。"

# game/script.rpy:129543
translate chinese Ulric1_map190_8_0_bf5fce45:

    # char_ulric "Hey." nointeract
    char_ulric "嘿。" nointeract

# game/script.rpy:129561
translate chinese Ulric1_map190_8_0_8ed69820:

    # voice "se/y01369.ogg"
    # char_ulric "I'm grateful for your support, I really am.\nI've always told you how much I want to change this place.\nAnd now I'm getting the chance? This almost feels like a dream."
    voice "se/y01369.ogg"
    char_ulric "我很感激你的支持，真的。\n我一直跟你说，我有多想改变这个地方。\n现在机会来了？这几乎像做梦一样。"

# game/script.rpy:129565
translate chinese Ulric1_map190_8_0_ab146ac0:

    # voice "se/y01370.ogg"
    # char_ulric "I'm not a fan of what Pro did, though.\nI hate to say this, but I'm prepared to kill him.\nIf I see an opening — I have to take it, [firstname]."
    voice "se/y01370.ogg"
    char_ulric "不过，我不喜欢普洛的做法。\n我不想这么说，但我已经准备好杀了他。\n只要看到破绽——我就必须下手，[firstname]。"

# game/script.rpy:129579
translate chinese Ulric1_map190_8_0_ce2c9661:

    # voice "se/y01371.ogg"
    # char_ulric "I think I need a few drinks after all of this.\nTruth be told, I'm still a little confused about everything.\nBut I assume that confusion will wane when the battle starts."
    voice "se/y01371.ogg"
    char_ulric "经历这一切之后，我想我得喝几杯。\n说实话，我对所有事还是有点困惑。\n但我猜，等战斗开始，这种困惑就会消退。"

# game/script.rpy:129583
translate chinese Ulric1_map190_8_0_f9386b5e:

    # voice "se/y01372.ogg"
    # char_ulric "I'm going to go check out the rest of the castle.\nI'll see you around. Remember — party responsibly."
    voice "se/y01372.ogg"
    char_ulric "我要去看看城堡的其他地方。\n回头见。记住——饮酒要有度。"

# game/script.rpy:129601
translate chinese Ulric1_map190_8_0_b5ce699d:

    # voice "se/y01373.ogg"
    # char_ulric "I'm upset with you, I won't hide the truth.\nIf Vivien wins, you've screwed us all over.\nHe'll remember where you placed your loyalty."
    voice "se/y01373.ogg"
    char_ulric "我对你很失望，我不会隐瞒。\n如果薇薇安赢了，你就把我们所有人都害惨了。\n他会记得你把忠心放在了哪里。"

# game/script.rpy:129605
translate chinese Ulric1_map190_8_0_678266f0:

    # voice "se/y01374.ogg"
    # char_ulric "And I'm {i}not{/i} going to hold back in that arena.\nIf I have to kill Pro to win, I'm going to do it.\nYou know I want to change this nation."
    voice "se/y01374.ogg"
    char_ulric "而且在竞技场上，我{i}绝不会{/i}手下留情。\n如果为了取胜必须杀了普洛，我会动手。\n你知道我有多想改变这个国家。"

# game/script.rpy:129619
translate chinese Ulric1_map190_8_0_3a276eed:

    # voice "se/y01375.ogg"
    # char_ulric "Nothing will get in my way. That includes you.\nSo if you'll excuse me, I'm going to explore the castle.\nSpirits know I need a few drinks after everything that happened."
    voice "se/y01375.ogg"
    char_ulric "什么都挡不住我。包括你。\n所以请见谅，我要去逛逛城堡了。\n天晓得，经历了这一切，我需要喝几杯。"

# game/script.rpy:129684
translate chinese Howl1_map190_9_0_5ccc4691:

    # char_howl "Hmm..." nointeract
    char_howl "嗯……" nointeract

# game/script.rpy:129702
translate chinese Howl1_map190_9_0_f57ea17b:

    # voice "se/y01382.ogg"
    # char_howl "We believe you made the wrong choice, [firstname].\nDraycu has yet to lose any fights in the coliseum.\nThis fight doesn't appear to be any different."
    voice "se/y01382.ogg"
    char_howl "我们认为你做了错误的选择，[firstname]。\n德雷库在竞技场里还从未输过。\n这场战斗看起来也不会有什么不同。"

# game/script.rpy:129706
translate chinese Howl1_map190_9_0_fc30bea8:

    # voice "se/y01383.ogg"
    # char_howl "The strength he could've offered was incredible, too.\nBut instead you decided to choose the weaker man.\nIdeals aside, choosing weakness makes no sense."
    voice "se/y01383.ogg"
    char_howl "他本可提供的实力也非常惊人。\n可你却决定选择较弱的一方。\n抛开理想不谈，选择软弱毫无道理。"

# game/script.rpy:129720
translate chinese Howl1_map190_9_0_6d08f9d6:

    # voice "se/y01384.ogg"
    # char_howl "Who cares about a changed Alarinthia if we lose the war?\nWe could give Vivien what he wants, and then march to our deaths.\nStrength is what wins wars, not the desire for change, and not hope."
    voice "se/y01384.ogg"
    char_howl "如果我们输掉这场战争，阿拉林西亚改不改变又有什么意义？\n我们可能满足了薇薇安的心愿，然后走向死亡。\n赢得战争靠的是实力，不是改变的渴望，也不是希望。"

# game/script.rpy:129734
translate chinese Howl1_map190_9_0_48716422:

    # voice "se/y01385.ogg"
    # char_howl "We will be exploring the castle if you need us.\nThe ballroom is our next stop, so we can meet there.\nIn the meantime, enjoy this ball as much as you can."
    voice "se/y01385.ogg"
    char_howl "你需要我们的话，我们会在城堡里四处看看。\n下一站是舞厅，我们可以在那儿碰头。\n在此期间，尽量好好享受这场舞会吧。"

# game/script.rpy:129752
translate chinese Howl1_map190_9_0_2bcb9d22:

    # voice "se/y01386.ogg"
    # char_howl "You made the right choice. That much is clear.\nWe need power to win this army. Draycu has that power.\nIt is unfortunate that Vivien or Ulric will perish, however."
    voice "se/y01386.ogg"
    char_howl "你做了正确的选择。这一点很清楚。\n要打赢这场战争，我们需要力量。德雷库拥有那份力量。\n不过，薇薇安或乌尔里克会丧命，这很不幸。"

# game/script.rpy:129756
translate chinese Howl1_map190_9_0_a881a099:

    # voice "se/y01387.ogg"
    # char_howl "But they will meet a noble end, fighting for their beliefs.\nWe will go on to ally with Draycu, and defeat The Triumvirate.\nWe cannot say the same, had you chose to side with Vivien."
    voice "se/y01387.ogg"
    char_howl "但他们将为信念而战，迎来一个高尚的结局。\n我们将与德雷库结盟，击败三人执政团。\n若你选择站在薇薇安那边，我们就无法这么说了。"

# game/script.rpy:129770
translate chinese Howl1_map190_9_0_68475198:

    # voice "se/y01388.ogg"
    # char_howl "Vivien offers little power, and focuses not on Alestia.\nTo him, the change of Alarinthia is all that matters.\nWe need allies who are less short-sighted."
    voice "se/y01388.ogg"
    char_howl "薇薇安提供不了多少力量，而且心思并不在阿莱斯蒂亚上。\n对他来说，改变阿拉林西亚才是唯一重要的。\n我们需要目光更长远的盟友。"

# game/script.rpy:129784
translate chinese Howl1_map190_9_0_073d2317:

    # voice "se/y01389.ogg"
    # char_howl "Thank you for asking our opinion, by the way.\nWe value every chance we have to speak with you.\nIf you need us, we will be in the ballroom for a while."
    voice "se/y01389.ogg"
    char_howl "顺便说一句，谢谢你征询我们的意见。\n我们珍惜每一次与你交谈的机会。\n如果需要我们，我们会在舞厅待一会儿。"

# game/script.rpy:129849
translate chinese Pro1_map190_10_0_e3e029c7:

    # char_pro "Hey." nointeract
    char_pro "嘿。" nointeract

# game/script.rpy:129867
translate chinese Pro1_map190_10_0_a3e6488a:

    # voice "se/y01376.ogg"
    # char_pro "I think you sided against me.\nIn the future, I'll remember that.\nI thought we were friends, you know."
    voice "se/y01376.ogg"
    char_pro "我觉得你站到了我的对立面。\n往后我会记住这一点。\n你知道，我还以为我们是朋友。"

# game/script.rpy:129881
translate chinese Pro1_map190_10_0_c057b18a:

    # voice "se/y01377.ogg"
    # char_pro "When the fighting starts, I won't hold back.\nI just want to be on Draycu's good side, you know?\nIf he ends up winning, I still want to form an alliance."
    voice "se/y01377.ogg"
    char_pro "战斗一开始，我不会手下留情。\n我只是想讨德雷库的欢心，你懂吗？\n万一他最后赢了，我还是想跟他结盟。"

# game/script.rpy:129895
translate chinese Pro1_map190_10_0_e451e409:

    # voice "se/y01378.ogg"
    # char_pro "But if Vivien wins? Well, I don't know...\nThat means either myself, or Draycu would be dead.\nI'm not going to think about that. Let's go check out the ball."
    voice "se/y01378.ogg"
    char_pro "可要是薇薇安赢了呢？嗯，我不知道……\n那意味着要么是我，要么是德雷库会死。\n我不想再想这个了。我们去逛逛舞会吧。"

# game/script.rpy:129913
translate chinese Pro1_map190_10_0_c340a208:

    # voice "se/y01379.ogg"
    # char_pro "I'm glad we share the same views.\nSiding with Draycu was the clear choice.\nWe need strength to win this war. He has lots."
    voice "se/y01379.ogg"
    char_pro "很高兴我们看法一致。\n站在德雷库这边是显而易见的选择。\n我们需要力量来打赢这场战争。他有很多。"

# game/script.rpy:129927
translate chinese Pro1_map190_10_0_a1e89c6e:

    # voice "se/y01380.ogg"
    # char_pro "I don't mind changing Alarinthia — it's just not time.\nMaybe in the future, that's something we can look at doing.\nBut for now, we need power. Change can come {i}after{/i} the war."
    voice "se/y01380.ogg"
    char_pro "我不反对改变阿拉林西亚——只是时机未到。\n也许将来，我们可以考虑去做这件事。\n但现在，我们需要力量。改变可以等战争{i}之后{/i}再说。"

# game/script.rpy:129931
translate chinese Pro1_map190_10_0_8da401a5:

    # voice "se/y01381.ogg"
    # char_pro "I think I'll go check out the rest of the ball.\nIf this might be my last night alive, I might as well enjoy it.\nThe ballroom sounds pretty cool, so that's where I'll be."
    voice "se/y01381.ogg"
    char_pro "我想我要去看看舞会别的地方。\n如果这可能是我人生的最后一晚，那我干脆好好享受。\n舞厅听起来挺不错，我会在那儿。"

# game/script.rpy:129995
translate chinese Fortaime1_map190_11_0_6707371b:

    # char_fortaime "Hmm..." nointeract
    char_fortaime "嗯……" nointeract

# game/script.rpy:130013
translate chinese Fortaime1_map190_11_0_283bc654:

    # voice "se/y01390.ogg"
    # char_fortaime "I'm glad you sided with Ulric and Vivien.\nIt's important to change this nation for the better.\nI just wish Pro didn't have to open his big mouth."
    voice "se/y01390.ogg"
    char_fortaime "很高兴你站到了乌尔里克和薇薇安这边。\n让这个国家变得更好很重要。\n我只是希望普洛没那么多嘴。"

# game/script.rpy:130017
translate chinese Fortaime1_map190_11_0_3c8f31fa:

    # voice "se/y01391.ogg"
    # char_fortaime "There's a very real chance that he'll die tomorrow.\nWe've seen Ulric fight. I think he'll win this battle.\nI just hope it's Draycu that falls. Not Pro..."
    voice "se/y01391.ogg"
    char_fortaime "他明天真的很有可能会死。\n我们见过乌尔里克战斗。我觉得他会赢下这场战斗。\n我只希望倒下的是德雷库。不是普洛……"

# game/script.rpy:130031
translate chinese Fortaime1_map190_11_0_fd7ecc05:

    # voice "se/y01392.ogg"
    # char_fortaime "That sounds like a horrible thing to say, I know.\nBut we've all grown so close since we met at Peregrino.\nI'm scared this clash of ideals will tear our bonds apart."
    voice "se/y01392.ogg"
    char_fortaime "我知道，这话听着很残忍。\n但自从在佩雷格里诺相遇，我们都变得如此亲近。\n我害怕这场理念的冲突会把我们的羁绊撕碎。"

# game/script.rpy:130045
translate chinese Fortaime1_map190_11_0_dd5ea0e9:

    # voice "se/y01393.ogg"
    # char_fortaime "I need to get my mind off of that, or I'll go crazy.\nIf you need me, I'll be in the ballroom down the hall.\nI heard they have a live band, and I love music...!"
    voice "se/y01393.ogg"
    char_fortaime "我得转移一下注意力，不然我会疯掉。\n如果你需要我，我就在走廊尽头的舞厅。\n我听说那儿有现场乐队，我超爱音乐……！"

# game/script.rpy:130063
translate chinese Fortaime1_map190_11_0_5ca6e22c:

    # voice "se/y01394.ogg"
    # char_fortaime "Well Draycu gives us the best chance at winning this war.\nHe's undefeated, so logic dictates that won't be changing.\nI just hate to think that his victory means Ulric might die."
    voice "se/y01394.ogg"
    char_fortaime "德雷库给了我们打赢这场战争的最好机会。\n他从无败绩，按道理这也不会改变。\n我只是一想到他的胜利可能意味着乌尔里克会死，就难受。"

# game/script.rpy:130067
translate chinese Fortaime1_map190_11_0_bcb395b3:

    # voice "se/y01395.ogg"
    # char_fortaime "I feel so bad for him. He always spoke about changing Alarinthia.\nBut when he's given the chance, his comrades side against him?\nHe must feel so lonely right now. Only Vivien's army has his back."
    voice "se/y01395.ogg"
    char_fortaime "我真为他难过。他总是说要改变阿拉林西亚。\n可当机会来临时，他的同伴却站到了他的对立面？\n他现在一定很孤独。只有薇薇安的军队支持他。"

# game/script.rpy:130081
translate chinese Fortaime1_map190_11_0_08353a0c:

    # voice "se/y01396.ogg"
    # char_fortaime "Draycu has both Pro, and a handful or our rebel forces.\nThat means if Ulric kills, it's more likely to be a friend than a foe.\nBeing forced to do that in order to win your dream? I can't even imagine."
    voice "se/y01396.ogg"
    char_fortaime "德雷库那边既有普洛，也有我们反抗军的一小部分人。\n这意味着，如果乌尔里克要杀人，杀的更可能是朋友而不是敌人。\n为了赢得梦想而被迫这么做？我根本无法想象。"

# game/script.rpy:130095
translate chinese Fortaime1_map190_11_0_8f91be9d:

    # voice "se/y01397.ogg"
    # char_fortaime "So I guess I'll stop thinking about it, and focus on the ball.\nIf you need me, I think I was going to check out the ballroom.\nI heard they have a live band, and I just {i}love{/i} listening to music."
    voice "se/y01397.ogg"
    char_fortaime "所以我想我还是别再想了，专心享受舞会吧。\n如果你需要我，我应该是要去舞厅看看。\n我听说那儿有现场乐队，我{i}最{/i}喜欢听音乐了。"

