    # voice "se/a00194.ogg"
    # char_ulric "There's no point. They'd never give it back.\nWe'd only end up bringing more attention to ourselves.\nI think we'll just have to chalk this one up as a loss."
    voice "se/a00194.ogg"
    char_ulric "没用的。他们绝不会退钱。\n那样只会引来更多注意。\n我看这一笔只能认栽了。"

# game/script.rpy:34271
translate chinese click_map064_9_EV009_71fe4903:

    # voice "se/a00195.ogg"
    # char_fortaime "Alright, I'm sorry..."
