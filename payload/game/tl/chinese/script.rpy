    char_jit_map023_1_0_16 "可是——！"

# game/script.rpy:177178
translate chinese map023_cc9afb20:

    # "Pro cuts him off before he can continue, and looks me in the eye."
    "没等他说下去，普洛就打断了他，然后直视着我的眼睛。"

