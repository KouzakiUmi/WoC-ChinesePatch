# game/script.rpy:34335
translate chinese click_map064_36_EV036_50674d28:

    # voice "se/a00202.ogg"
    # char_fortaime "Where do the people live then?"
    voice "se/a00202.ogg"
    char_fortaime "那人们住在哪儿？"

# game/script.rpy:34339
translate chinese click_map064_36_EV036_b872c80a:

    # voice "se/a00203.ogg"
    # char_pro "Most of them have small beds behind their market stalls.\nThose that are lucky enough to own an actual shop, live inside of it.\nIf you want to live in Mazeo, you need to sell something of value."
    voice "se/a00203.ogg"
    char_pro "大多数人就在摊位后面搭张小床。\n运气好、能拥有真正店面的人，就住在店里。\n想在马泽奥生活，你就得卖点有价值的东西。"

# game/script.rpy:34343
translate chinese click_map064_36_EV036_cd4b4b22:

    # voice "se/a00204.ogg"
    # char_ulric "Or offer your services.\nLike me with my sword arm."
    voice "se/a00204.ogg"
    char_ulric "或者靠自己的本事吃饭。\n就像我靠这把剑一样。"

# game/script.rpy:34347
translate chinese click_map064_36_EV036_aae8ff4d:

    # voice "se/a00205.ogg"
    # char_pro "Yeah. You need to do {i}something{/i} to make money.\nIf you live in a residential area, that means you're rich.\nIt's a sign of wealth — like you don't need to work anymore."
    voice "se/a00205.ogg"
    char_pro "是啊。你总得做{i}点什么{/i}来赚钱。\n要是住在住宅区，那就说明你有钱。\n那是财富的象征——好像你再也不用干活了。"

# game/script.rpy:34351
translate chinese click_map064_36_EV036_4fa2fbba:

    # voice "se/a00206.ogg"
    # char_fortaime "I'm guessing not everybody gets that far..."
    voice "se/a00206.ogg"
    char_fortaime "我猜不是人人都能走到那一步……"

# game/script.rpy:34355
translate chinese click_map064_36_EV036_26e7e951:

    # voice "se/a00207.ogg"
    # char_ulric "No. Most people live on a day-to-day basis.\nIf they don't sell something that day, they don't eat."
    voice "se/a00207.ogg"
    char_ulric "不。大多数人都是过一天算一天。\n那天没卖出东西，就没饭吃。"

# game/script.rpy:34359
translate chinese click_map064_36_EV036_bb51680a:

    # voice "se/a00208.ogg"
    # char_valessa "That's crazy. \nIn Valinorth, we share everything.\nWe'd never stand by while a citizen starves."
    voice "se/a00208.ogg"
    char_valessa "太不可思议了。\n在瓦利诺斯，我们分享一切。\n我们绝不会坐视任何一位同胞挨饿。"

# game/script.rpy:34363
translate chinese click_map064_36_EV036_d725cb7b:

    # voice "se/a00209.ogg"
    # char_pro "Yeah, you have it pretty good in Valinorth.\nBut this is what I like to call the \"real world\", Valessa.\nValinorth was special. The rest of the world is more like {i}this{/i}."
    voice "se/a00209.ogg"
    char_pro "是啊，你们在瓦利诺斯过得挺不错。\n但这才是我所谓的“现实世界”，瓦莱莎。\n瓦利诺斯是特别的。外面的世界更接近{i}这样{/i}。"

# game/script.rpy:34367
translate chinese click_map064_36_EV036_ab02b555:

    # voice "se/a00210.ogg"
    # char_fortaime "Hopefully we can change that...\nWhere do you think we'll be living after the war?"
    voice "se/a00210.ogg"
    char_fortaime "希望我们能改变这一切……\n你觉得战后我们会住在哪儿？"

# game/script.rpy:34371
translate chinese click_map064_36_EV036_f30dec41:

    # voice "se/a00211.ogg"
    # char_pro "If we survive? \nWherever we want."
    voice "se/a00211.ogg"
    char_pro "如果我们能活下来？\n想住哪儿住哪儿。"

