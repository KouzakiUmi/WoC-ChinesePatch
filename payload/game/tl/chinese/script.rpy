    # char_ulric "I'm not picky. I just like the effects.\nThe stronger stuff is more expensive though, and I'm not loaded.\nWell, unless Damek decides to treat me, I guess. That's rare, though."
    char_ulric "我不挑，只要有效果就行。\n不过烈酒更贵，而我没什么钱。\n唔，除非达梅克肯请我，大概。不过那可少见。"

# game/script.rpy:31121
translate chinese Ulric9_map054_9_0_eb35c342:

    # voice "se/y00673.ogg"
    voice "se/y00673.ogg"

# game/script.rpy:31123
