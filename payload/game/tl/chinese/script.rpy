# game/script.rpy:72022
translate chinese map141_2245499e:

    # voice "se/z01363.ogg"
    # char_howl "No, but they created you. The {i}new{/i} residents of Alestia.\nBuilt in their image of perfection, to counter our corrupt nature.\nThey stole our world, and our future — handing it off to {i}you{/i}."
    voice "se/z01363.ogg"
    char_howl "不，但他们创造了你们。阿莱斯蒂亚的{i}新{/i}居民。\n按他们心目中的完美形象塑造，用以对抗我们堕落的本性。\n他们偷走了我们的世界和未来——把它交到了{i}你们{/i}手上。"

# game/script.rpy:72048
translate chinese map141_88703244:

    # voice "se/z01364.ogg"
    # char_damek "This is incredible."
    voice "se/z01364.ogg"
    char_damek "这太不可思议了。"

