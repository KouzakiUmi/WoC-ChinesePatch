translate chinese map198_c547ff0e:

    # voice "se/z01901.ogg"
    # char_howl "It is less than ideal, yes.\nBut we cannot change our circumstances.\nLet us gather together for last minute preparations."
    voice "se/z01901.ogg"
    char_howl "确实不尽如人意。\n但我们无法改变处境。\n让我们聚到一起做最后的准备吧。"

# game/script.rpy:137181
translate chinese map198_1676d754:

    # voice "se/z01902.ogg"
    # char_howl "Only by preparing for the coming storm, can we avoid tragedy.\nIf we stand here any longer, the odds of losing our comrades will grow.\nDo not let the enemy get the upper hand. That has happened enough."
