    # voice "se/w00278.ogg"
    voice "se/w00278.ogg"

# game/script.rpy:21975
translate chinese click_map154_23_EV023_4ee7740e:

    # char_mylus "You are not my Father."
    char_mylus "你不是我的父亲。"

# game/script.rpy:21988
translate chinese click_map154_23_EV023_4bc5e6bf:

    # voice "se/w00279.ogg"
    voice "se/w00279.ogg"

# game/script.rpy:21990
translate chinese click_map154_23_EV023_81bb5a5d:

    # char_howl "Do you say this to inform us, or to console {i}yourself{/i}?"
    char_howl "你说这话，是为了告知我们，还是为了安慰{i}你自己{/i}？"

# game/script.rpy:22003
translate chinese click_map154_23_EV023_98924b23:

    # voice "se/w00280.ogg"
    voice "se/w00280.ogg"

# game/script.rpy:22005
translate chinese click_map154_23_EV023_344d6606:

    # char_mylus "Huh...?"
    char_mylus "嗯……？"

# game/script.rpy:22018
translate chinese click_map154_23_EV023_52d3dad8:

    # voice "se/w00281.ogg"
    voice "se/w00281.ogg"

# game/script.rpy:22020
translate chinese click_map154_23_EV023_f0888075:

    # char_howl "This question was self explanatory."
    char_howl "这个问题不言自明。"

# game/script.rpy:22033
translate chinese click_map154_23_EV023_e4cac70f:

    # voice "se/w00282.ogg"
    voice "se/w00282.ogg"

# game/script.rpy:22035
translate chinese click_map154_23_EV023_fb1d46aa:

    # char_mylus "It's just — I should be mad at you. Furious.\nYou defile the memory and likeness of my Father."
    char_mylus "只是——我本该生你的气。暴怒才对。\n你玷污了我父亲的记忆与模样。"

# game/script.rpy:22048
translate chinese click_map154_23_EV023_a9ee08e7:

    # voice "se/w00283.ogg"
    voice "se/w00283.ogg"

# game/script.rpy:22050
translate chinese click_map154_23_EV023_e76bc392:

    # char_howl "Do we...?\nIt seems that \"Salus\" was an honorable man.\nAre we not carrying out his final wishes?"
    char_howl "是吗……？\n看来“萨鲁斯”是位可敬的人。\n我们难道不是在完成他最后的遗愿吗？"

# game/script.rpy:22063
translate chinese click_map154_23_EV023_50e301ec:

    # voice "se/w00284.ogg"
    voice "se/w00284.ogg"

# game/script.rpy:22065
translate chinese click_map154_23_EV023_566115b7:

    # char_mylus "What?"
    char_mylus "什么？"

# game/script.rpy:22078
translate chinese click_map154_23_EV023_832c6d56:

    # voice "se/w00285.ogg"
    voice "se/w00285.ogg"

# game/script.rpy:22080
translate chinese click_map154_23_EV023_ffc00b28:

    # char_howl "The freedom of Alestia. The destruction of The Triumvirate.\nWhen you look at it that way, it seems as if we defile nothing."
    char_howl "阿莱斯蒂亚的自由。三人执政团的覆灭。\n若从这个角度看，我们似乎什么都没有玷污。"

# game/script.rpy:22093
translate chinese click_map154_23_EV023_62e0331c:

    # voice "se/w00286.ogg"
    voice "se/w00286.ogg"

# game/script.rpy:22095
translate chinese click_map154_23_EV023_1b728418:

    # char_mylus "I... I don't know."
    char_mylus "我……我不知道。"

# game/script.rpy:22108
translate chinese click_map154_23_EV023_ad9d7ccd:

    # voice "se/w00287.ogg"
    voice "se/w00287.ogg"

# game/script.rpy:22110
translate chinese click_map154_23_EV023_7a436d22:

    # char_howl "What are you wishing to know?"
    char_howl "你想知道什么？"

# game/script.rpy:22123
translate chinese click_map154_23_EV023_51f5050c:

    # voice "se/w00288.ogg"
    voice "se/w00288.ogg"

# game/script.rpy:22125
translate chinese click_map154_23_EV023_30e2f090:

    # char_mylus "I want to know how I should feel right now!\nThis is just so bizarre — I have no idea what to do.\nBack in Valinorth, things were so simple, and easy."
    char_mylus "我想知道我现在到底该怎么想！\n这太离奇了——我完全不知道该怎么办。\n在瓦利诺斯的时候，一切都那么简单、轻松。"

# game/script.rpy:22138
translate chinese click_map154_23_EV023_3bd353ff:

    # voice "se/w00289.ogg"
    voice "se/w00289.ogg"

# game/script.rpy:22140
translate chinese click_map154_23_EV023_ee99b51e:

    # char_howl "Why must you do anything?\nYou could mull over this development for years, you know.\nAt the end of the day, you should do something more useful."
    char_howl "你何必非得做点什么？\n你知道，这事你大可以琢磨上好几年。\n说到底，你该去做些更有用的事。"

# game/script.rpy:22153
translate chinese click_map154_23_EV023_85547573:

    # voice "se/w00290.ogg"
    voice "se/w00290.ogg"

# game/script.rpy:22155
translate chinese click_map154_23_EV023_6758af8e:

    # char_mylus "Like what?"
    char_mylus "比如什么？"

# game/script.rpy:22168
translate chinese click_map154_23_EV023_5f7c82d1:

    # voice "se/w00291.ogg"
    voice "se/w00291.ogg"

# game/script.rpy:22170
translate chinese click_map154_23_EV023_2649fa4c:

    # char_howl "This is not for us to decide.\nBut have no worries, we will take care of this body.\nAnd using it, we will do everything we can to honor your Father."
    char_howl "这不是能由我们决定的。\n但别担心，我们会照看好这具身体。\n借助它，我们会竭尽所能，以彰显你父亲的荣光。"

# game/script.rpy:22183
translate chinese click_map154_23_EV023_e55778d6:

    # voice "se/w00292.ogg"
    voice "se/w00292.ogg"

# game/script.rpy:22185
translate chinese click_map154_23_EV023_5a0af2c0:

    # char_mylus "Thank you...\nI'll let you know if I think of anything.\nThis might take a while for me to understand."
    char_mylus "谢谢你……\n我要是想到什么，会告诉你的。\n这大概需要些时间我才能弄明白。"

# game/script.rpy:22198
translate chinese click_map154_23_EV023_77506069:

    # voice "se/w00293.ogg"
    voice "se/w00293.ogg"

# game/script.rpy:22200
translate chinese click_map154_23_EV023_dec22d64:

    # char_howl "Very well, but please remember this.\nLack of understanding is not a fault. In fact, it can be a strength.\nYou flourished even though you did not know the truth of the spirits."
    char_howl "很好，但请记住这一点。\n不懂并非过错。事实上，它也可以是一种力量。\n即便不知灵体的真相，你也茁壮成长至今。"

# game/script.rpy:22213
translate chinese click_map154_23_EV023_81176b09:

    # voice "se/w00294.ogg"
    voice "se/w00294.ogg"

# game/script.rpy:22215
translate chinese click_map154_23_EV023_9dfbc127:

    # char_mylus "You're right...\nI think I need some time alone.\nI'll be down in the crew quarters, Howl."
    char_mylus "你说得对……\n我想我需要一个人静一静。\n我会在下面的船员舱，豪尔。"

# game/script.rpy:22262
translate chinese map155_64e512a4:

    # "I make my way down into the crew area of the ship.{w}\nMy bed isn't too hard to find, and at least I have privacy.{w}\nI find myself remembering what Gryz told me about the blade."
    "我下到船上的船员区。{w}\n我的床不难找，至少这里还有私密可言。{w}\n我不由想起格瑞兹告诉过我的关于那把剑的事。"

# game/script.rpy:22264
translate chinese map155_1ff0362c:

    # "It bends to the will of the wielder. That much was true.{w}\nI've been able to use it to accomplish so much already.{w}\nBut what are the true limits of its power? Did I want to know?"
    "它顺应持刃者的意志。这一点确实不假。{w}\n我已经能用它完成这么多事了。{w}\n可它力量的真正极限在哪里？我想知道吗？"

# game/script.rpy:22269
translate chinese map155_ff661b3f:

    # "I rest the blade on my bed and sit beside it, cross-legged.{w}\nClosing my eyes, I start to focus, and clear my mind.{w}\nThis is probably a good time to test my limits."
    "我把剑放在床上，盘腿坐在旁边。{w}\n闭上眼，我开始凝神，清空思绪。{w}\n这大概是个测试自己极限的好时机。"

# game/script.rpy:22271
translate chinese map155_88ca8a8c:

    # "Blade of Exodus — show me our victory."
    "放逐之刃——向我展现我们的胜利。"

# game/script.rpy:22273
translate chinese map155_ac1a412c:

    # "I reach forward, and gently touch the blade.{w}\nMy eyes are shut tight, and my resolve is clear.{w}\nYet, try and wish as I might — nothing happens at all."
    "我伸出手，轻轻触碰那把剑。{w}\n我双目紧闭，心意坚定。{w}\n可无论我怎样尝试、怎样期盼——什么也没有发生。"

# game/script.rpy:22275
translate chinese map155_473f70ed:

    # "Did the blade have nothing to show me?{w}\nOr maybe, was I scared of seeing the future?{w}\nIt could be worse. Was there no victory in sight...?"
    "是那把剑无物可给我看吗？{w}\n又或者，是我害怕看见未来？{w}\n情况可能更糟。难道看不到任何胜利……？"

# game/script.rpy:22277
translate chinese map155_9b881887:

    # "I pull back, and open my eyes. It didn't work.{w}\nI scoff, and rest the blade at my bedside, concerned.{w}\nI drift off to sleep, with an anxiety that wasn't there before."
    "我收回手，睁开眼。没有成功。{w}\n我嗤了一声，忧心地把剑放在床边。{w}\n我沉沉睡去，带着一份此前不曾有过的焦虑。"

# game/script.rpy:22295
translate chinese map155_c265fc58:

    # "When I wake up, I see the sun pierce through the windows.{w}\nWith everything I was told — that means we're in Alarinthia.{w}\nI grab the blade, and immediately get out of bed."
    "醒来时，我看见阳光穿过窗棂。{w}\n按我听说的种种——这意味着我们到了阿拉林西亚。{w}\n我抓起那把剑，立刻下了床。"

# game/script.rpy:22297
translate chinese map155_be5ede46:

    # "Running around the ship, I see nobody in sight.{w}\nDid they leave without me...? That's odd.{w}\nOr maybe they let me sleep in."
    "我在船上四处跑了一圈，一个人影也没看见。{w}\n他们难道丢下我走了……？真奇怪。{w}\n又或许，他们让我多睡了会儿。"

# game/script.rpy:22299
translate chinese map155_b6f103da:

    # "After everything that happened, I guess I'm thankful.{w}\nI search for a map of Alarinthia, and inspect it closely.{w}\nIf they left, then I should be able to meet them at the docks."
    "经历这一切之后，我想我是心怀感激的。{w}\n我找了张阿拉林西亚的地图，仔细查看。{w}\n若他们先走了，我该能在码头与他们会合。"

