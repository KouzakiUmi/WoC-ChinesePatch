    # char_valessa "Can you imagine if somebody did that to us...?\nHelping us out — only to use us for information?\nI feel bad for suggesting it, but dire times, you know?"
    char_valessa "你能想象有人这么对我们吗……？\n帮我们一把——只是为了从我们身上套情报？\n提出这种想法我很过意不去，但时局艰难，你懂的？"

# game/script.rpy:20774
translate chinese map047_278c0437:

    # voice "se/y00421.ogg"
    voice "se/y00421.ogg"

# game/script.rpy:20776
