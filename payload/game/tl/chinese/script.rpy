    # char_ulric "Hey, what are you doing!?"
    char_ulric "嘿，你在干什么！？"

# game/script.rpy:154379
translate chinese click_map160_7_EV007_7bcdecfa:

    # voice "se/a00256.ogg"
    # char_fortaime "Oh, nothing! Nothing at all!"
    voice "se/a00256.ogg"
    char_fortaime "哦，没什么！一点事都没有！"

# game/script.rpy:154383
translate chinese click_map160_7_EV007_193513c5:

    # voice "se/a00257.ogg"
    # char_ulric "I just told you to stay away from those things!\nCome on, Fortaime, you're smarter than that."
    voice "se/a00257.ogg"
    char_ulric "我刚才才跟你说离那些东西远点！\n得了吧，福泰姆，你没那么蠢。"

# game/script.rpy:154421
translate chinese click_map160_9_EV009_e6337f48:

    # voice "se/a00269.ogg"
    voice "se/a00269.ogg"

# game/script.rpy:154423
translate chinese click_map160_9_EV009_a69e426a:

    # char_damek "They sure gave us a good ship.\nI have to say, that alliance was a great idea."
    char_damek "他们确实给了我们一艘好船。\n不得不说，那个联盟是个好主意。"

# game/script.rpy:154426
translate chinese click_map160_9_EV009_53ad82c9:

    # voice "se/a00270.ogg"
    # char_howl "This is an impressive vessel?"
    voice "se/a00270.ogg"
    char_howl "这就算一艘了不起的船了？"

# game/script.rpy:154430
translate chinese click_map160_9_EV009_71bea3c1:

    # voice "se/a00271.ogg"
    # char_damek "Of course. It's amazing."
    voice "se/a00271.ogg"
    char_damek "当然了。它棒极了。"

# game/script.rpy:154434
translate chinese click_map160_9_EV009_7457710a:

    # voice "se/a00272.ogg"
    # char_howl "That is underwhelming.\nThe Monarchy had much bigger vessels.\nWe simply assumed that the pirates held back."
    voice "se/a00272.ogg"
    char_howl "这让人有些失望。\n君主国曾有比这大得多的船舰。\n我们只是以为海盗们留了一手。"

# game/script.rpy:154438
translate chinese click_map160_9_EV009_7a444826:

    # voice "se/a00273.ogg"
    # char_damek "Oh..."
    voice "se/a00273.ogg"
    char_damek "哦……"

# game/script.rpy:154442
translate chinese click_map160_9_EV009_9c23e07d:

    # voice "se/a00274.ogg"
    # char_howl "Of course, we do not wish to condescend.\nWe only wish to inform you of this world's past.\nSurely that is something that interests you?"
    voice "se/a00274.ogg"
    char_howl "当然，我们无意居高临下。\n我们只是想让你了解这个世界的过去。\n想必那会是你感兴趣的东西吧？"

# game/script.rpy:154446
translate chinese click_map160_9_EV009_1a3f7848:

    # voice "se/a00275.ogg"
    # char_damek "Oh, well when you put it that way — sure.\nSorry, I thought you were rubbing it in my face."
    voice "se/a00275.ogg"
    char_damek "哦，既然你这么说——那好吧。\n抱歉，我还以为你是故意在挖苦我。"

# game/script.rpy:154450
translate chinese click_map160_9_EV009_66e637cd:

    # voice "se/a00276.ogg"
    # char_howl "Only partly."
    voice "se/a00276.ogg"
    char_howl "只有一部分是。"

