# game/script.rpy:31230
translate chinese click_map054_12_EV012_5a271dc4:

    # voice "se/a00147.ogg"
    # char_ulric "Try for ten, little one.\nJust stick by my side, and you won't get lost.\nI don't feel like running around town trying to find you."
    voice "se/a00147.ogg"
    char_ulric "往十倍上猜吧，小家伙。\n跟紧我身边就不会走丢。\n我可不想满城跑着找你。"

# game/script.rpy:31234
translate chinese click_map054_12_EV012_57b797ba:

    # voice "se/a00148.ogg"
    # char_fortaime "Again, I'm not little!\nAnd trust me, I'll never get lost.\nI have a pretty good sense of direction."
    voice "se/a00148.ogg"
    char_fortaime "再说一遍，我不是小家伙！\n而且相信我，我绝不会走丢。\n我方向感很好的。"

# game/script.rpy:31238
translate chinese click_map054_12_EV012_43208f09:

    # voice "se/a00149.ogg"
    # char_valessa "Says the guy who got lost on his way home last week."
