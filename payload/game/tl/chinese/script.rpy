    # voice "se/x00278.ogg"
    voice "se/x00278.ogg"

# game/script.rpy:164387
translate chinese map114_e9f06b07:

    # char_jit_map114_1_0_11 "Yeah, but that was ages ago.\nIt's all in the past. You're a better man, now."
    char_jit_map114_1_0_11 "是啊，但那是很久以前了。\n都是过去的事了。你现在是个更好的人。"

# game/script.rpy:164412
