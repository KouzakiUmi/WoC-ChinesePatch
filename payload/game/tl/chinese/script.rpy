    # script.rpy:1248
    old "{image=icons/819.png} \"I'm the Seeress...\""
    new "{image=icons/819.png} “我是女先知……”"

    # script.rpy:1248
    old "{image=icons/818.png} \"I'm the Seer...\""
    new "{image=icons/818.png} “我是先知……”"

    # script.rpy:1418
    old "{image=icons/579.png} [[Sad] \"Wait, so we're letting them die to buy us time?\""
    new "{image=icons/579.png} [[悲伤] “等等，我们就为了争取时间，让他们去送死？”"

    # script.rpy:1418
    old "{image=icons/660.png} [[Happy] \"Good idea. Let them soak it up for us.\""
    new "{image=icons/660.png} [[开心] “好主意。让他们替我们挡着。”"

    # script.rpy:1418
    old "{image=icons/580.png} [[Neutral] \"There has to be another way to do this.\""
    new "{image=icons/580.png} [[中立] “一定还有别的办法。”"

    # script.rpy:1800
    old "{image=icons/651.png} \"I don't know what's going on right now.\""
    new "{image=icons/651.png} “我不知道现在发生了什么。”"

    # script.rpy:1800
    old "{image=icons/651.png} \"I can't seem to remember anything.\""
    new "{image=icons/651.png} “我好像什么都想不起来了。”"

    # script.rpy:1944
    old "{image=icons/579.png} \"I can't fight, I have no training!\""
    new "{image=icons/579.png} “我不能战斗，我没受过任何训练！”"

    # script.rpy:1944
    old "{image=icons/653.png} [[Aggressive] \"Of course. I'll defend myself as well.\""
    new "{image=icons/653.png} [[强硬] “当然。我也会保护自己。”"

    # script.rpy:3759
    old "{image=icons/651.png} \"Wait, what's The Triumvirate...?\""
    new "{image=icons/651.png} “等等，三人执政团是什么……？”"

    # script.rpy:3759
    old "{image=icons/651.png} \"Why would they do such a thing...?\""
    new "{image=icons/651.png} “他们为什么要做这种事……？”"

    # script.rpy:4613
    old "{image=icons/651.png} \"Focus on lives. Go to The Grand Tree.\""
    new "{image=icons/651.png} “救人要紧。去巨树。”"

    # script.rpy:4613
    old "{image=icons/651.png} \"Focus on information. Go after Mylus.\""
    new "{image=icons/651.png} “情报优先。去追迈勒斯。”"

    # script.rpy:6369
    old "{image=icons/651.png} \"Find anything useful?\""
    new "{image=icons/651.png} “找到什么有用的东西了吗？”"

    # script.rpy:6369
    old "{image=icons/651.png} \"Are you sure this is a vision?\""
    new "{image=icons/651.png} “你确定这是幻象吗？”"

    # script.rpy:6369
    old "{image=icons/651.png} \"We've known each other our whole lives?\""
    new "{image=icons/651.png} “我们从小就认识吗？”"

    # script.rpy:6369
    old "[[Exit]"
    new "[[退出]"

    # script.rpy:6393
    old "{image=icons/651.png} \"How long has he been the Elder?\""
    new "{image=icons/651.png} “他当长老多久了？”"

    # script.rpy:6393
    old "{image=icons/651.png} \"You seem to think highly of him.\""
    new "{image=icons/651.png} “你似乎很敬重他。”"

    # script.rpy:6393
    old "{image=icons/651.png} \"What if he's helping The Rebellion?\""
    new "{image=icons/651.png} “万一他在帮反抗军呢？”"

    # script.rpy:6393
    old "[[Back]"
    new "[[返回]"

    # script.rpy:6416
    old "{image=icons/651.png} \"What happened to his Dad?\""
    new "{image=icons/651.png} “他父亲怎么了？”"

    # script.rpy:6416
    old "{image=icons/651.png} \"Don't speak too soon. Look at what's happening.\""
    new "{image=icons/651.png} “别急着下结论。看看现在发生的事。”"

    # script.rpy:6497
    old "{image=icons/651.png} \"If he doesn't want to do it, he shouldn't have to.\""
    new "{image=icons/651.png} “如果他不想做，就不该逼他。”"

    # script.rpy:6497
    old "{image=icons/651.png} \"Maybe I should step up after this is all over.\""
    new "{image=icons/651.png} “也许等这一切结束后，我该挺身而出。”"

    # script.rpy:6497
    old "{image=icons/651.png} \"Oh well. Life puts you in some crazy situations.\""
    new "{image=icons/651.png} “算了。生活总会把人扔进各种疯狂的处境。”"

    # script.rpy:6601
    old "{image=icons/651.png} \"Could anything excuse what's going on right now?\""
    new "{image=icons/651.png} “现在发生的这一切，还有什么借口可言吗？”"

    # script.rpy:6601
    old "{image=icons/651.png} \"He'd sure have a lot of explaining to do.\""
    new "{image=icons/651.png} “他可得好好解释一番了。”"

    # script.rpy:6709
    old "{image=icons/651.png} \"What would be the harm in telling him?\""
    new "{image=icons/651.png} “告诉他又能有什么坏处呢？”"

    # script.rpy:6709
    old "{image=icons/651.png} \"Rules? What kind of rules are there?\""
    new "{image=icons/651.png} “规矩？都有什么规矩？”"

    # script.rpy:6767
    old "{image=icons/651.png} \"How long do they last?\""
    new "{image=icons/651.png} “它们会持续多久？”"

    # script.rpy:6767
    old "{image=icons/651.png} \"Why do the spirits give me visions?\""
    new "{image=icons/651.png} “为什么灵要给我幻象？”"

    # script.rpy:6767
    old "{image=icons/651.png} \"You call this a gift...?\""
    new "{image=icons/651.png} “你管这叫天赋……？”"

    # script.rpy:6829
    old "{image=icons/651.png} \"Nobody helps for free, Valessa.\""
    new "{image=icons/651.png} “没人会无偿帮忙，瓦莱莎。”"

    # script.rpy:6829
    old "{image=icons/651.png} \"We must be eternally grateful.\""
    new "{image=icons/651.png} “我们必须永远心怀感激。”"

    # script.rpy:6936
    old "{image=icons/651.png} \"What are a Scribe's duties?\""
    new "{image=icons/651.png} “书记官的职责是什么？”"

    # script.rpy:6936
    old "{image=icons/651.png} \"Are you the only Scribe?\""
