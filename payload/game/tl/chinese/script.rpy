# game/script.rpy:162046
translate chinese click_map110_17_EV017_f1d44b39:

    # "The church looks so out of place.{w}\nI've never seen anything like it before.{w}\nIt doesn't look Mazean, that's for sure."
    "这座教堂看起来格格不入。{w}\n我以前从没见过这样的东西。{w}\n它肯定不像马泽奥的风格。"

# game/script.rpy:162049
translate chinese click_map110_17_EV017_c42a38f3:

    # voice "se/a00245.ogg"
    # char_valessa "It looks creepy..."
    voice "se/a00245.ogg"
    char_valessa "看起来好瘆人……"

# game/script.rpy:162053
translate chinese click_map110_17_EV017_d06f29f8:

    # voice "se/a00246.ogg"
    # char_ulric "It's modelled after Balteus.\nThat's what things look like over there."
    voice "se/a00246.ogg"
    char_ulric "它是仿照巴尔泰乌斯建的。\n那边的东西就长这样。"

# game/script.rpy:162057
translate chinese click_map110_17_EV017_586d5fb2:

    # voice "se/a00247.ogg"
    # char_valessa "And that's where we're going next.\nJust great. Now I'm even more afraid.\nWho makes stuff like this anyway...?"
    voice "se/a00247.ogg"
    char_valessa "而我们下一站就是去那儿。\n好极了。现在我更害怕了。\n到底是谁造出这种东西的……？"

# game/script.rpy:162061
translate chinese click_map110_17_EV017_53e99673:

    # voice "se/a00248.ogg"
    # char_ulric "Your guess is as good as mine.\nIt doesn't fit in with any part of Alestia.\nBalteus is really distinct. It's kind of cool."
    voice "se/a00248.ogg"
    char_ulric "我和你一样不知道。\n它跟阿莱斯蒂亚的任何地方都不搭。\n巴尔泰乌斯真的很独特。挺酷的。"

# game/script.rpy:162065
translate chinese click_map110_17_EV017_796d7aaf:

    # voice "se/a00249.ogg"
    # char_valessa "I'll take your word for it..."
    voice "se/a00249.ogg"
    char_valessa "我就信你一回……"

# game/script.rpy:162132
translate chinese map109_0139d3d7:

    # "As soon as we enter, Damek walks down the center aisle.{w}\nHe trails a finger along the pews as he does, gathering up dust."
    "我们一进去，达梅克就沿着中央过道往前走。{w}\n他一边走一边用手指划过长椅，沾起灰尘。"

# game/script.rpy:162157
translate chinese map109_6a1e84cb:

    # voice "se/z01065.ogg"
    voice "se/z01065.ogg"

