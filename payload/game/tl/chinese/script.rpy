# game/script.rpy:34259
translate chinese click_map064_9_EV009_30d3d90e:

    # voice "se/a00192.ogg"
    # char_ulric "Yeah. I can let my guard down, too.\nSo don't feel bad about your mistake, Fortaime."
    voice "se/a00192.ogg"
    char_ulric "是啊。我也会有放松警惕的时候。\n所以别为自己的失误难过，福泰姆。"

# game/script.rpy:34263
translate chinese click_map064_9_EV009_dfe2cabf:

    # voice "se/a00193.ogg"
    # char_valessa "If anything, he learned an important lesson.\nShould we go complain? Maybe he can get his money back."
