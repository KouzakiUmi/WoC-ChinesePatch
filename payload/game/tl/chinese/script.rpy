    char_valessa "我们该怎么办……？" nointeract

# game/script.rpy:4638
translate chinese map037_02eb50e5:

    # "Vision or not, I couldn't let all those people die.{w}\nIt was my duty to save as many people as possible."
    "不管是不是幻象，我都不能眼看着那些人去死。{w}\n尽可能多救人，是我的职责。"

# game/script.rpy:4664
translate chinese map037_a1d6cfcb:

    # voice "se/z00106.ogg"
    voice "se/z00106.ogg"

