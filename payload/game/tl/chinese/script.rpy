translate chinese click_map160_10_EV010_c2300f66:

    # voice "se/a00277.ogg"
    voice "se/a00277.ogg"

# game/script.rpy:154490
translate chinese click_map160_10_EV010_ab105799:

    # char_fortaime "So what're these boxes for?"
    char_fortaime "那这些箱子是干什么用的？"

# game/script.rpy:154493
translate chinese click_map160_10_EV010_34cac1bb:

    # voice "se/a00278.ogg"
    # char_ulric "I'm not sure. Probably food and supplies.\nIt's a long trek to Alarinthia. You need sustenance."
    voice "se/a00278.ogg"
    char_ulric "我不确定。大概是食物和补给吧。\n去阿拉林西亚路途遥远，需要补给。"

# game/script.rpy:154497
